<Window x:Class="ShiftHandOver.Client.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShiftHandOver.Client"
        mc:Ignorable="d"
        Title="PLUS MART — ĐĂNG NHẬP HỆ THỐNG"
        Width="480" Height="550"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Label Style -->
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="LoginComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- DatePicker Style -->
        <Style x:Key="LoginDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Decor -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar với nút Admin ở góc phải -->
            <RowDefinition Height="*"/>    <!-- Main Card -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP BAR: ĐĂNG NHẬP DƯỚI QUYỀN ADMIN Ở GÓC BÊN TRÊN BÊN PHẢI -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#000000" Padding="18,10">
            <Grid>
                <!-- Tiêu đề thương hiệu nhỏ góc trái -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Center">
                        <Image Source="/ShiftHandOver.Client;component/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="PLUS MART" FontWeight="Black" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border BorderBrush="#FFFFFF" BorderThickness="1,0,0,0" Height="16" Margin="12,0,12,0"/>
                    <TextBlock Text="CỔNG BÀN GIAO CA" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nút ĐĂNG NHẬP DƯỚI QUYỀN ADMIN ở góc bên trên bên phải -->
                <Button Grid.Column="0" HorizontalAlignment="Right" x:Name="btnToggleAdmin"
                        Content="Đăng nhập quyền Admin" Height="30" Padding="12,0"
                        Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                        BorderBrush="#FFFFFF" BorderThickness="1" Cursor="Hand" Click="BtnToggleAdmin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. MAIN CARD: LOGO & FORM ĐĂNG NHẬP                            -->
        <!-- ============================================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="8"
                    Margin="24,20" Padding="28,24">

                <StackPanel>
                    <!-- LOGO CỦA PHẦN IMAGE (PLUS MART - NGUYÊN BẢN HÌNH ẢNH MÀU SẮC THƯƠNG HIỆU) -->
                    <Border Width="96" Height="96" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,12" ClipToBounds="True">
                        <Image Source="/ShiftHandOver.Client;component/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Tiêu đề Header -->
                    <TextBlock Text="PLUS MART" FontSize="22" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock Text="HỆ THỐNG GIAO NHẬN VÀ CHỐT CA" FontSize="12" FontWeight="SemiBold" Foreground="#000000" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Border BorderBrush="#000000" BorderThickness="0,0,0,1" Margin="0,0,0,18"/>

                    <!-- ================================================== -->
                    <!-- FORM 1: CHỌN CƠ SỞ & CA ĐỂ VÀO BÀN GIAO CA (MẶC ĐỊNH) -->
                    <!-- ================================================== -->
                    <StackPanel x:Name="pnlEmployeeLogin">
                        <!-- Chọn cơ sở (lấy động từ Database) -->
                        <TextBlock Text="Chọn Cơ sở:" Style="{StaticResource InputLabel}"/>
                        <ComboBox x:Name="cboBranch" Style="{StaticResource LoginComboBox}" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <!-- Chọn ca làm việc (4 ca chuẩn từ hệ thống) -->
                        <TextBlock Text="Chọn Ca làm việc:" Style="{StaticResource InputLabel}"/>
                        <ComboBox x:Name="cboShift" Style="{StaticResource LoginComboBox}" DisplayMemberPath="Name" SelectedValuePath="Code"/>

                        <!-- Chọn ngày làm việc -->
                        <TextBlock Text="Chọn Ngày:" Style="{StaticResource InputLabel}"/>
                        <DatePicker x:Name="dpWorkDate" Style="{StaticResource LoginDatePicker}" Margin="0,0,0,24">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>

                        <!-- Nút VÀO CA & GIAO NHẬN CA -->
                        <Button x:Name="btnLoginEmployee" Content="VÀO CA VÀ GIAO NHẬN CA" Height="46"
                                Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                                BorderThickness="0" Cursor="Hand" Click="BtnLoginEmployee_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- FORM 2: ĐĂNG NHẬP DƯỚI QUYỀN ADMIN (QUẢN TRỊ VIÊN) -->
                    <!-- ================================================== -->
                    <StackPanel x:Name="pnlAdminLogin" Visibility="Collapsed">
                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,18">
                            <TextBlock Text="CHẾ ĐỘ ĐĂNG NHẬP QUẢN TRỊ VIÊN (ADMIN)" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Tài khoản Admin -->
                        <TextBlock Text="Tài khoản Quản trị (Admin):" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="txtAdminUser" Style="{StaticResource LoginTextBox}" Text=""/>

                        <!-- Mật khẩu Admin -->
                        <TextBlock Text="Mật khẩu Quản trị:" Style="{StaticResource InputLabel}"/>
                        <PasswordBox x:Name="txtAdminPass" Style="{StaticResource LoginPasswordBox}" Password=""/>

                        <!-- Nút Đăng nhập Admin -->
                        <Button x:Name="btnLoginAdmin" Content="ĐĂNG NHẬP TRANG QUẢN TRỊ" Height="46"
                                Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                                BorderThickness="0" Cursor="Hand" Click="BtnLoginAdmin_Click" Margin="0,8,0,12">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Nút Quay lại -->
                        <Button Content="Quay lại giao nhận ca nhân viên" Height="38"
                                Background="#FFFFFF" Foreground="#000000" FontWeight="SemiBold" FontSize="13"
                                BorderBrush="#000000" BorderThickness="1" Cursor="Hand" Click="BtnBackToEmployee_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
