<Window x:Class="ShiftHandOver.Client.Admin.BranchEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cơ sở Bán hàng — Plus Mart"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Border BorderBrush="#000000" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Form nhập -->
                <RowDefinition Height="Auto"/> <!-- Footer nút -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER -->
            <Border Grid.Row="0" Background="#000000" Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="TxtDialogTitle" Text="THÊM CƠ SỞ BÁN HÀNG MỚI" FontWeight="Black" FontSize="14" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtDialogSubtitle" Text="Thiết lập chi nhánh mới với cấu trúc bán hàng riêng biệt" 
                               FontSize="11" Foreground="#CCCCCC" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. FORM NHẬP -->
            <StackPanel Grid.Row="1" Margin="20,16,20,16">
                <!-- Tên cơ sở -->
                <TextBlock Text="Tên cơ sở / Chi nhánh bán hàng:" FontWeight="SemiBold" FontSize="12" Foreground="#000000" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtBranchName" Height="34" FontSize="12" Padding="8,0" VerticalContentAlignment="Center"
                         BorderBrush="#000000" BorderThickness="1.5" Margin="0,0,0,12"/>

                <!-- Tiền mặt đầu ca mặc định -->
                <TextBlock Text="Mức tiền két mặc định ban đầu (VNĐ):" FontWeight="SemiBold" FontSize="12" Foreground="#000000" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCashOpening" Text="2,000,000" Height="34" FontSize="12" Padding="8,0" VerticalContentAlignment="Center"
                         BorderBrush="#000000" BorderThickness="1.5" Margin="0,0,0,12"/>

                <!-- Trạng thái hoạt động -->
                <CheckBox x:Name="ChkIsActive" Content="Đang hoạt động (Cho phép mở ca và bán hàng tại cơ sở này)" 
                          IsChecked="True" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 3. FOOTER NÚT -->
            <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" Width="90" Height="32" Background="#FFFFFF" Foreground="#000000"
                            BorderBrush="#000000" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnSave" Content="LƯU CƠ SỞ" Width="120" Height="32" Background="#000000" Foreground="#FFFFFF"
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
