<Window x:Class="ShiftHandOver.Client.Admin.AdminDashBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShiftHandOver.Client.Admin"
        mc:Ignorable="d"
        Title="PLUS MART — HỆ THỐNG QUẢN TRỊ VÀ GIÁM SÁT CHỐT CA"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- TabItem Style Đen Trắng -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#000000"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#000000"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Đen Nền Chữ Trắng -->
        <Style x:Key="PrimaryBlackButton" TargetType="Button">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button Viền Trắng Đen / Outline -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl Dạng Sidebar Dọc Bên Trái Cho Settings -->
        <Style x:Key="SidebarTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CỘT TRÁI: THANH DANH MỤC CÀI ĐẶT -->
                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="10,12" Margin="0,0,14,0" VerticalAlignment="Stretch">
                                <StackPanel>
                                    <Border Background="#000000" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                                        <TextBlock Text="DANH MỤC THIẾT LẬP" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel IsItemsHost="True"/>
                                </StackPanel>
                            </Border>

                            <!-- CỘT PHẢI: HIỂN THỊ NỘI DUNG TỪNG TAB -->
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Dạng Sidebar Dọc Bên Trái Cho Tra Cứu -->
        <Style x:Key="LookupSidebarTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CỘT TRÁI: THANH DANH MỤC TRA CỨU -->
                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="10,12" Margin="0,0,12,0" VerticalAlignment="Stretch">
                                <StackPanel>
                                    <Border Background="#000000" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                                        <TextBlock Text="MỤC TRA CỨU" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel IsItemsHost="True"/>
                                </StackPanel>
                            </Border>

                            <!-- CỘT PHẢI: HIỂN THỊ NỘI DUNG TỪNG TAB -->
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem Con Dạng Nút Danh Mục Dọc Lề Trái -->
        <Style x:Key="SubTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="SubTabBorder"
                                Background="#FFFFFF"
                                BorderBrush="#000000"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,0,6"
                                Cursor="Hand">
                            <ContentPresenter x:Name="SubTabHeaderContent" ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SubTabBorder" Property="Background" Value="#000000"/>
                                <Setter TargetName="SubTabHeaderContent" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SubTabBorder" Property="Background" Value="#000000"/>
                                <Setter TargetName="SubTabBorder" Property="BorderBrush" Value="#000000"/>
                                <Setter TargetName="SubTabHeaderContent" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="SubTabHeaderContent" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR HEADER (ĐEN TRẮNG) -->
        <Border Grid.Row="0" Background="#000000" CornerRadius="6" Padding="18,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                        <Image Source="/ShiftHandOver.Client;component/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="PLUS MART" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#000000" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,12,0">
                        <TextBlock Text="Quyền: Quản trị viên" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="Đăng xuất" Width="90" Height="30" Background="#000000" Foreground="#FFFFFF"
                            BorderBrush="#FFFFFF" BorderThickness="1" Cursor="Hand" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TAB CONTROL CHÍNH -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ============================================================== -->
            <!-- TAB 1: TỔNG QUAN THÁNG (DASHBOARD & KPI)                         -->
            <!-- ============================================================== -->
            <TabItem Header="TỔNG QUAN THÁNG" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Bộ chọn tháng / Cơ sở -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Xem dữ liệu tháng:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CbMonthFilterTab1" Width="150" Height="32" SelectionChanged="CbMonthFilterTab1_SelectionChanged"/>
                                    <TextBlock Text="Cơ sở:" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,10,0"/>
                                    <ComboBox x:Name="CbBranchFilterTab1" Width="180" Height="32" SelectionChanged="CbBranchFilterTab1_SelectionChanged"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Xuất báo cáo tháng" Style="{StaticResource OutlineButton}" Click="BtnExportReport_Click"/>
                            </Grid>
                        </Border>

                        <!-- 4 THẺ KPI CHÍNH (ĐEN TRẮNG) -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Tổng số ca hoàn thành trong tháng -->
                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="TỔNG CA HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                    <TextBlock x:Name="TxtKpiTotalShifts" Text="0 Ca" FontSize="22" FontWeight="Black" Foreground="#000000" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtKpiTotalShiftsSub" Text="Đang cập nhật..." FontSize="11" Foreground="#555555" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Tiền mặt thực thu một tháng -->
                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="TIỀN MẶT THỰC THU" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                    <TextBlock x:Name="TxtKpiCashActualEarned" Text="0 đ" FontSize="22" FontWeight="Black" Foreground="#000000" Margin="0,4,0,0"/>
                                    <TextBlock Text="Tổng tiền mặt chênh lệch" FontSize="11" Foreground="#555555" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Tổng số ca Âm (Thiếu tiền) -->
                            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="TỔNG SỐ CA ÂM THIẾU TIỀN" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="TxtKpiNegativeShifts" Text="0 Ca" FontSize="22" FontWeight="Black" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtKpiNegativePercent" Text=" (0%)" FontSize="11" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtKpiNegativeTotal" Text="Tổng hụt: 0 đ" FontSize="11" Foreground="#555555" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Tổng số ca Dương (Thừa tiền) -->
                            <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="TỔNG SỐ CA DƯƠNG THỪA TIỀN" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="TxtKpiPositiveShifts" Text="0 Ca" FontSize="22" FontWeight="Black" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtKpiPositivePercent" Text=" (0%)" FontSize="11" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtKpiPositiveTotal" Text="Tổng thừa: 0 đ" FontSize="11" Foreground="#555555" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- BẢNG CÁC CA LỆCH TIỀN CẦN GIẢI TRÌNH (FULL WIDTH) -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                    <TextBlock Text="DANH SÁCH CÁC CA BỊ LỆCH TIỀN GẦN NHẤT CẦN THEO DÕI" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                </Border>

                                <DataGrid x:Name="DgRecentShiftDiff" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="0" Margin="8" MinHeight="380">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Ca" Binding="{Binding ShiftId}" Width="190"/>
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding ShiftDate}" Width="110"/>
                                        <DataGridTextColumn Header="Ca" Binding="{Binding ShiftType}" Width="100"/>
                                        <DataGridTextColumn Header="Cơ sở" Binding="{Binding BranchName}" Width="160"/>
                                        <DataGridTextColumn Header="Người đóng ca" Binding="{Binding ClosedByUser}" Width="150"/>
                                        <DataGridTextColumn Header="Tiền mặt chênh lệch" Binding="{Binding CashDiffDisplay}" Width="160"/>
                                        <DataGridTextColumn Header="Tiền chênh lệch" Binding="{Binding CashDifference}" Width="140"/>
                                        <DataGridTextColumn Header="Ghi chú giải trình" Binding="{Binding Note}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================== -->
            <!-- TAB 2: TRA CỨU & ĐỐI SOÁT BIÊN BẢN (MASTER - DETAIL)            -->
            <!-- ============================================================== -->
            <TabItem Header="TRA CỨU VÀ BIÊN BẢN CHỐT CA" Style="{StaticResource ModernTabItem}">
                <TabControl x:Name="TcLookupTabs" Style="{StaticResource LookupSidebarTabControl}" Margin="0,8,0,0">

                    <!-- SUB-TAB 1: TỔNG QUAN (MÀN TRA CỨU BIÊN BẢN HIỆN TẠI) -->
                    <TabItem Header="Tổng quan" Style="{StaticResource SubTabItem}">
                        <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- THANH BỘ LỌC (Ngày, Cơ sở, Ca, Nhân viên) -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lọc Ngày -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Chọn ngày:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpFilterDate" Width="130" Height="32"/>
                            </StackPanel>

                            <!-- Lọc Cơ sở -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Tên cơ sở:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbFilterBranch" Width="145" Height="32"/>
                            </StackPanel>

                            <!-- Lọc Tên Ca -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Tên ca:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbFilterShiftType" Width="120" Height="32"/>
                            </StackPanel>

                            <!-- Lọc Tên Nhân viên -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Nhân viên:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbFilterEmployee" Width="150" Height="32"/>
                            </StackPanel>

                            <!-- Nút Lọc & Đặt lại -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Lọc dữ liệu" Style="{StaticResource PrimaryBlackButton}" Margin="0,0,8,0" Click="BtnFilterShifts_Click"/>
                                <Button Content="Đặt lại" Style="{StaticResource OutlineButton}" Click="BtnResetShiftFilter_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtFilterCount" Grid.Column="6" Text="Hiển thị: 0 Biên bản tìm thấy" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- MASTER - DETAIL (2 CỘT: DANH SÁCH BÊN TRÁI, BIÊN BẢN BÊN PHẢI) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4.5*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="5.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: DANH SÁCH CÁC CA ĐÃ LỌC -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Background="#000000" CornerRadius="4,4,0,0" Padding="12,10">
                                    <TextBlock Text="DANH SÁCH CA BÀN GIAO" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                </Border>

                                <DataGrid x:Name="DgShiftList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="0" Margin="6" SelectionChanged="DgShiftList_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Ca" Binding="{Binding ShiftId}" Width="185"/>
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding ShiftDate}" Width="90"/>
                                        <DataGridTextColumn Header="Ca" Binding="{Binding ShiftType}" Width="80"/>
                                        <DataGridTextColumn Header="Cơ sở" Binding="{Binding BranchName}" Width="100"/>
                                        <DataGridTextColumn Header="Người chốt" Binding="{Binding ClosedByUser}" Width="110"/>
                                        <DataGridTextColumn Header="Chênh lệch" Binding="{Binding CashDifference}" Width="100"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- CỘT PHẢI: HIỂN THỊ TẤT CẢ THÔNG TIN BIÊN BẢN CHỐT CA ĐÓ -->
                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" TextElement.Foreground="#000000">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                    <Grid>
                                        <TextBlock x:Name="TxtDetailShiftCode" Text="CHƯA CHỌN BIÊN BẢN NÀO" Foreground="#FFFFFF" FontWeight="Black" FontSize="13"/>
                                        <Border x:Name="BdrDetailDiffBadge" HorizontalAlignment="Right" Background="#000000" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="3" Padding="8,2">
                                            <TextBlock x:Name="TxtDetailDiffBadge" Text="—" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14" TextElement.Foreground="#000000">
                                    <StackPanel>
                                        <!-- 1. Thông tin chung ca làm -->
                                        <Border Background="#F9FAFB" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12" TextElement.Foreground="#000000">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock x:Name="TxtDetailBranch" Text="Cơ sở: —" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtDetailShiftType" Text="Ca làm: —" Foreground="#000000" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtDetailDate" Text="Ngày làm việc: —" Foreground="#000000" Margin="0,0,0,6"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="TxtDetailOpenedBy" Text="Người mở ca: —" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtDetailClosedBy" Text="Người đóng ca: —" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtDetailEmployees" Text="Nhân viên cùng trực: —" Foreground="#000000" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- VÙNG 1: TIỀN MẶT TẠI KÉT -->
                                        <TextBlock Text="1. TIỀN MẶT TẠI KÉT" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,14" TextElement.Foreground="#000000">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="1"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Đầu ca -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Đầu ca (tiền mồi két):" FontWeight="SemiBold" Foreground="#000000" Margin="0,4"/>
                                                <TextBlock x:Name="TxtDetailCashOpening" Grid.Row="0" Grid.Column="1" Text="0 đ" FontWeight="Black" Foreground="#000000" Margin="0,4"/>

                                                <!-- Hết ca -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hết ca (tiền kiểm đếm):" FontWeight="SemiBold" Foreground="#000000" Margin="0,4"/>
                                                <TextBlock x:Name="TxtDetailCashClosing" Grid.Row="1" Grid.Column="1" Text="0 đ" FontWeight="Black" Foreground="#000000" Margin="0,4"/>

                                                <!-- Kẻ phân cách -->
                                                <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Fill="#000000" Margin="0,8"/>

                                                <!-- Tổng âm/dương so với ban đầu -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Chênh lệch tiền mặt tại két:" FontWeight="Black" FontSize="13" Foreground="#000000" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                                <TextBlock x:Name="TxtDetailCashDiff" Grid.Row="3" Grid.Column="1" Text="0 đ" FontWeight="Black" FontSize="14" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- VÙNG 2: DOANH SỐ BÁN HÀNG QUA MÁY POS -->
                                        <TextBlock Text="2. DOANH SỐ BÁN HÀNG QUA MÁY POS" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,14" TextElement.Foreground="#000000">
                                            <StackPanel>
                                                <!-- Máy POS 1 -->
                                                <Border BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <TextBlock x:Name="TxtDetailPos1Label" Text="Máy POS 1 (Sapo POS)" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                            <TextBlock x:Name="TxtDetailPos1Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock x:Name="TxtDetailPos1Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Máy POS 2 -->
                                                <Border BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <TextBlock x:Name="TxtDetailPos2Label" Text="Máy POS 2 (KiotViet)" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                            <TextBlock x:Name="TxtDetailPos2Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock x:Name="TxtDetailPos2Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Tổng doanh số POS -->
                                                <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                                    <Grid>
                                                        <TextBlock Text="TỔNG DOANH SỐ BÁN HÀNG QUA POS:" FontWeight="Black" FontSize="12" Foreground="#000000"/>
                                                        <TextBlock x:Name="TxtDetailTotalPos" Text="0 đ" FontWeight="Black" FontSize="13" Foreground="#000000" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- VÙNG 3: DOANH THU CHUYỂN KHOẢN & NGÂN HÀNG -->
                                        <TextBlock Text="3. DOANH THU CHUYỂN KHOẢN &amp; NGÂN HÀNG" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,14" TextElement.Foreground="#000000">
                                            <StackPanel>
                                                <!-- Ngân hàng 1 -->
                                                <Border x:Name="PnlDetailBank1Group" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <TextBlock x:Name="TxtDetailBank1Label" Text="Ngân hàng 1 (TingTing)" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                            <TextBlock x:Name="TxtDetailBank1Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock x:Name="TxtDetailBank1Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Ngân hàng 2 -->
                                                <Border x:Name="PnlDetailBank2Group" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <TextBlock x:Name="TxtDetailBank2Label" Text="Ngân hàng 2 (Zalo Pay)" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                            <TextBlock x:Name="TxtDetailBank2Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock x:Name="TxtDetailBank2Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Tổng doanh thu ngân hàng -->
                                                <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                                    <Grid>
                                                        <TextBlock Text="TỔNG TIỀN CHUYỂN KHOẢN &amp; NGÂN HÀNG:" FontWeight="Black" FontSize="12" Foreground="#000000"/>
                                                        <TextBlock x:Name="TxtDetailTotalBank" Text="0 đ" FontWeight="Black" FontSize="13" Foreground="#000000" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- VÙNG 4: KHOẢN CHI XUẤT KÉT TRONG CA -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="4. CÁC KHOẢN CHI XUẤT KÉT TRONG CA" FontWeight="Black" FontSize="12" Foreground="#000000" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailExpenseSummary" Text="Tổng đã chi: 0 đ" FontWeight="Bold" FontSize="11" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="10" Margin="0,0,0,14" TextElement.Foreground="#000000">
                                            <StackPanel>
                                                <ItemsControl x:Name="IcDetailExpenses">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8F9FA" BorderBrush="#000000" BorderThickness="1" Padding="10,7" CornerRadius="3" Margin="0,0,0,5">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="11" Foreground="#000000" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding AmountDisplay}" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="TxtNoExpensesNotice" Text="Không có khoản chi xuất két nào trong ca này." FontStyle="Italic" FontSize="11" Foreground="#555555" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- VÙNG 5: GHI CHÚ VÀ GIẢI TRÌNH CỦA NHÂN VIÊN -->
                                        <TextBlock Text="5. GHI CHÚ &amp; GIẢI TRÌNH CỦA NHÂN VIÊN CHỐT CA" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="12" TextElement.Foreground="#000000">
                                            <TextBlock x:Name="TxtDetailNote" Text="Không có ghi chú"
                                                       FontStyle="Italic" TextWrapping="Wrap" Foreground="#000000" LineHeight="18"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Nút tác vụ biên bản (CHỈ CHỨA CHỮ) -->
                                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="14,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="In biên bản" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="BtnPrintShift_Click"/>
                                        <Button Content="Yêu cầu bồi hoàn tiền âm" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="BtnRequestCompensation_Click"/>
                                        <Button Content="Duyệt chốt ca" Style="{StaticResource PrimaryBlackButton}" Click="BtnApproveShift_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                    </TabItem>

                    <!-- SUB-TAB 2: NHÂN VIÊN (TRA CỨU THEO NHÂN VIÊN) -->
                    <TabItem Header="Nhân viên" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Thanh bộ lọc nhân sự: Khoảng thời gian (Từ ngày, Đến ngày) & Tìm kiếm nhân viên -->
                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Lọc Từ ngày -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Từ ngày:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <DatePicker x:Name="DpLookupEmpFromDate" Width="125" Height="32"/>
                                    </StackPanel>

                                    <!-- Lọc Đến ngày -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Đến ngày:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <DatePicker x:Name="DpLookupEmpToDate" Width="125" Height="32"/>
                                    </StackPanel>

                                    <!-- Tìm kiếm nhân viên -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Tìm kiếm:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtSearchLookupEmp" Width="180" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1" TextChanged="TxtSearchLookupEmp_TextChanged"/>
                                    </StackPanel>

                                    <!-- Nút Lọc & Đặt lại -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Lọc dữ liệu" Style="{StaticResource PrimaryBlackButton}" Margin="0,0,8,0" Click="BtnFilterLookupEmpDate_Click"/>
                                        <Button Content="Đặt lại" Style="{StaticResource OutlineButton}" Click="BtnResetLookupEmpDate_Click"/>
                                    </StackPanel>

                                    <!-- Đếm số nhân sự -->
                                    <TextBlock x:Name="TxtLookupEmpCount" Grid.Column="5" Text="Tổng số nhân sự: 0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Khối 2 cột: Cột trái là Danh sách nhân viên, Cột phải là Lịch sử ca làm của nhân viên đó -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4.5*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="5.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CỘT TRÁI: DANH SÁCH NHÂN SỰ -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                            <TextBlock Text="DANH SÁCH NHÂN SỰ (CHỌN ĐỂ XEM LỊCH SỬ CA)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                        </Border>

                                        <DataGrid x:Name="DgLookupEmployees" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="#FFFFFF"
                                                  BorderThickness="0" Margin="6" SelectionChanged="DgLookupEmployees_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="135"/>
                                                <DataGridTextColumn Header="Tài khoản" Binding="{Binding Username}" Width="95"/>
                                                <DataGridTextColumn Header="Tổng số ca" Binding="{Binding TotalShiftsDisplay}" Width="95"/>
                                                <DataGridTextColumn Header="Âm" Binding="{Binding TotalNegativeDiff}" Width="110"/>
                                                <DataGridTextColumn Header="Dương" Binding="{Binding TotalPositiveDiff}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- CỘT PHẢI: LỊCH SỬ CÁC CA LÀM VIỆC CỦA NHÂN VIÊN ĐƯỢC CHỌN -->
                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header cột phải -->
                                        <Border Grid.Row="0" Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                            <Grid>
                                                <TextBlock x:Name="TxtSelectedEmpHeader" Text="LỊCH SỬ CA LÀM CỦA NHÂN VIÊN" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock x:Name="TxtSelectedEmpShiftCount" Text="0 ca làm việc" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>

                                        <!-- 3 Thẻ thống kê nhanh của nhân viên đang chọn -->
                                        <!-- 2 Thẻ thống kê nhanh của nhân viên đang chọn (Âm / Dương) -->
                                        <Grid Grid.Row="1" Margin="10,10,10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thẻ 1: Ca Âm -->
                                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="TỔNG TIỀN ÂM" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                    <TextBlock x:Name="TxtSelectedEmpNegativeDiff" Text="0 đ" FontSize="16" FontWeight="Black" Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="TxtSelectedEmpNegativeCount" Text="0 ca bị hụt tiền" FontSize="10.5" Foreground="#555555"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Thẻ 2: Ca Dương -->
                                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="TỔNG TIỀN DƯƠNG" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                    <TextBlock x:Name="TxtSelectedEmpPositiveDiff" Text="0 đ" FontSize="16" FontWeight="Black" Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="TxtSelectedEmpPositiveCount" Text="0 ca thừa tiền" FontSize="10.5" Foreground="#555555"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Bảng ca làm việc của nhân viên này -->
                                        <DataGrid x:Name="DgEmployeeShiftsDetail" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="#FFFFFF"
                                                  BorderThickness="0" Margin="6" MouseDoubleClick="DgEmployeeShiftsDetail_MouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Mã Ca" Binding="{Binding ShiftId}" Width="65"/>
                                                <DataGridTextColumn Header="Ngày" Binding="{Binding ShiftDate}" Width="90"/>
                                                <DataGridTextColumn Header="Ca" Binding="{Binding ShiftType}" Width="80"/>
                                                <DataGridTextColumn Header="Cơ sở" Binding="{Binding BranchName}" Width="1.5*"/>
                                                <DataGridTextColumn Header="Nhân viên trực" Binding="{Binding EmployeeNames}" Width="2*"/>
                                                <DataGridTextColumn Header="Chênh lệch" Binding="{Binding CashDifference}" Width="110"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- SUB-TAB 3: TIỀN CHI TRONG CA (CẢNH BÁO GIAN LẬN & CHI PHÍ KÉT) -->
                    <TabItem Header="Tiền chi trong ca" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: 3 Thẻ thống kê (Cards) -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1 -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="TỔNG TIỀN KÉT ĐÃ CHI TRONG THÁNG" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtExpenseTotalAmount" Text="0 đ" FontSize="22" FontWeight="Black" Foreground="#000000" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtExpenseTotalCount" Text="Tổng cộng: 0 phiếu xuất két" FontSize="11" Foreground="#000000" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2 -->
                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="CA LỆCH TIỀN VƯỢT HẠN MỨC" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtExpenseAlertCount" Text="0 Ca Cảnh Báo" FontSize="22" FontWeight="Black" Foreground="#000000" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtExpenseAlertSub" Text="Lệch tiền cần đối soát" FontSize="11" Foreground="#000000" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3 -->
                                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="KHOẢN CHI LỚN NHẤT ĐÃ XUẤT" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtExpenseMaxAmount" Text="0 đ" FontSize="22" FontWeight="Black" Foreground="#000000" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtExpenseMaxDesc" Text="Khoản chi lớn nhất trong danh sách" FontSize="11" Foreground="#000000" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 1: THANH BỘ LỌC (Cơ sở bán hàng, Tên nhân viên, Tìm kiếm lý do, Nút Lọc & Đặt lại) -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Lọc Cơ sở bán hàng -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Cơ sở:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CbExpenseFilterBranch" Width="150" Height="32" VerticalContentAlignment="Center" SelectionChanged="ExpenseFilter_Changed"/>
                                    </StackPanel>

                                    <!-- Lọc Tên Nhân viên -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Nhân viên:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CbExpenseFilterEmployee" Width="160" Height="32" VerticalContentAlignment="Center" SelectionChanged="ExpenseFilter_Changed"/>
                                    </StackPanel>

                                    <!-- Tìm kiếm từ khóa (Lý do, Ghi chú) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Tìm kiếm:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtSearchExpense" Width="180" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1" KeyDown="TxtSearchExpense_KeyDown"/>
                                    </StackPanel>

                                    <!-- Nút Lọc & Đặt lại -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Lọc dữ liệu" Style="{StaticResource PrimaryBlackButton}" Margin="0,0,8,0" Click="BtnFilterExpenses_Click"/>
                                        <Button Content="Đặt lại" Style="{StaticResource OutlineButton}" Click="BtnResetExpenseFilter_Click"/>
                                    </StackPanel>

                                    <!-- Đếm số lượng phiếu -->
                                    <TextBlock x:Name="TxtExpenseFilterCount" Grid.Column="5" Text="Hiển thị: 0 phiếu chi" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Row 2: Bảng soát xét chi phí két -->
                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                        <TextBlock Text="LỊCH SỬ XUẤT TIỀN KÉT ĐỂ ĐỐI SOÁT VỚI HÓA ĐƠN THỰC TẾ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Border>

                                    <DataGrid x:Name="DgExpenses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="0" Margin="8"
                                              HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding Id}" Width="75"/>
                                            <DataGridTextColumn Header="Mã Ca" Binding="{Binding ShiftId}" Width="185"/>
                                            <DataGridTextColumn Header="Cơ sở" Binding="{Binding BranchName}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Thời gian chi" Binding="{Binding CreatedAt}" Width="135"/>
                                            <DataGridTextColumn Header="Người bán trong ca" Binding="{Binding EmployeeNames}" Width="2.5*"/>
                                            <DataGridTextColumn Header="Số tiền xuất két" Binding="{Binding Amount}" Width="130"/>
                                            <DataGridTextColumn Header="Lý do chi" Binding="{Binding Description}" Width="3.5*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                </TabControl>
            </TabItem>

            <!-- ============================================================== -->
            <!-- TAB 4: CÀI ĐẶT & THIẾT LẬP HỆ THỐNG (SETTINGS)                 -->
            <!-- ============================================================== -->
            <TabItem Header="CÀI ĐẶT HỆ THỐNG" Style="{StaticResource ModernTabItem}">
                <TabControl Style="{StaticResource SidebarTabControl}" Margin="0,12,0,0">

                    <!-- SUB-TAB 1: QUẢN LÝ NHÂN VIÊN -->
                    <TabItem Header="Quản lý Nhân viên" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tìm kiếm nhân viên:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtSearchEmployee" Width="240" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,12,0" BorderBrush="#000000" BorderThickness="1"/>
                                        <Button Content="Tìm kiếm" Style="{StaticResource PrimaryBlackButton}" Click="BtnSearchEmployee_Click"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Thêm nhân viên mới" Style="{StaticResource PrimaryBlackButton}" Margin="0,0,8,0" Click="BtnAddEmployee_Click"/>
                                        <Button Content="Làm mới" Style="{StaticResource OutlineButton}" Click="BtnRefreshEmployees_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bảng nhân viên -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                        <Grid>
                                            <TextBlock Text="DANH SÁCH NHÂN SỰ &amp; THEO DÕI CHÊNH LỆCH TIỀN BÁN" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock x:Name="TxtEmployeeCountHeader" Text="Dữ liệu nhân sự trực quầy" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <DataGrid x:Name="DgEmployees" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="0" Margin="8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã NV" Binding="{Binding Id}" Width="60"/>
                                            <DataGridTextColumn Header="Tên tài khoản" Binding="{Binding Username}" Width="110"/>
                                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="150"/>
                                            <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="80"/>
                                            <DataGridTextColumn Header="Số ca đã làm" Binding="{Binding ShiftCount}" Width="95"/>
                                            <DataGridTextColumn Header="Số ca Âm" Binding="{Binding NegativeShiftCount}" Width="80"/>
                                            <DataGridTextColumn Header="Tổng tiền Âm" Binding="{Binding TotalNegativeDiff}" Width="115"/>
                                            <DataGridTextColumn Header="Số ca Dương" Binding="{Binding PositiveShiftCount}" Width="85"/>
                                            <DataGridTextColumn Header="Tổng tiền Dương" Binding="{Binding TotalPositiveDiff}" Width="120"/>
                                            <DataGridTextColumn Header="Số ca Khớp" Binding="{Binding BalancedShiftCount}" Width="85"/>
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding IsActive}" Width="90"/>
                                            <DataGridTemplateColumn Header="Hành động" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Sửa" Style="{StaticResource PrimaryBlackButton}" Padding="8,3" Margin="0,0,6,0" Click="BtnEditEmployee_Click"/>
                                                            <Button Content="Khóa / Mở" Style="{StaticResource OutlineButton}" Padding="8,3" Margin="0,0,6,0" Click="BtnToggleLockEmployee_Click"/>
                                                            <Button Content="Xóa" Style="{StaticResource OutlineButton}" Padding="8,3" Foreground="#CC0000" BorderBrush="#CC0000" Click="BtnDeleteEmployee_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- SUB-TAB 2: ĐIỀU CHỈNH CA LÀM (SET CA LÀM VIỆC) -->
                    <TabItem Header="Điều chỉnh Ca làm" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="CẤU HÌNH DANH MỤC CA LÀM VIỆC CỬA HÀNG" FontWeight="Bold" FontSize="14" Foreground="#000000"/>
                                        <TextBlock Text="Quy định phân ca, thời gian làm việc và số lượng nhân sự tối đa cho mỗi ca làm việc." Foreground="#000000" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Lưu cấu hình ca" Style="{StaticResource PrimaryBlackButton}" Padding="16,8" Click="BtnSaveShiftSchedule_Click"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <DataGrid x:Name="DgShiftSchedules" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="1" BorderBrush="#000000" Margin="0,0,0,16">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã Ca" Binding="{Binding Code}" Width="100" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Tên Ca Làm" Binding="{Binding Name}" Width="130" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Khung giờ làm việc" Binding="{Binding TimeRange}" Width="160"/>
                                            <DataGridTextColumn Header="Số nhân viên tối đa" Binding="{Binding MaxEmployees}" Width="140"/>
                                            <DataGridTextColumn Header="Đặc thù &amp; Quy định chốt sổ" Binding="{Binding Description}" Width="*"/>
                                            <DataGridCheckBoxColumn Header="Kích hoạt" Binding="{Binding IsActive}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Thẻ quy tắc nghiệp vụ ca -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="CÁC QUY TẮC BẮT BUỘC VỀ CA LÀM VIỆC (ĐÃ MÃ HÓA HỆ THỐNG):" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                            <TextBlock Text="• Khung giờ nghỉ giữa ca: 02:30 – 07:00 sáng hệ thống chặn mở ca mới do cửa hàng đóng cửa." Foreground="#000000" Margin="0,2"/>
                                            <TextBlock Text="• Ca Đêm (NIGHT): Diễn ra xuyên 00:00 (23:00 - 02:30 hôm sau), chốt sổ 1 lần duy nhất lúc 02:30 rạng sáng với 2 cột Day 1 và Day 2." Foreground="#000000" Margin="0,2"/>
                                            <TextBlock Text="• Giới hạn trực ca: Tối đa 2 nhân viên trong 1 ca làm việc, cả 2 nhân viên cùng chịu trách nhiệm liên đới." Foreground="#000000" Margin="0,2"/>
                                            <TextBlock Text="• Khóa ca quá khứ: Không thể tạo hoặc chỉnh sửa tự do ca của ngày hôm trước trừ ca Đêm đang diễn ra." Foreground="#000000" Margin="0,2"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- SUB-TAB 3: TẠO BIÊN BẢN (DANH SÁCH CƠ SỞ & CẤU HÌNH BIÊN BẢN CHỐT CA CHI TIẾT) -->
                    <TabItem Header="Tạo biên bản" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,4,0,0">

                            <!-- VIEW 1: DANH SÁCH BIÊN BẢN CỦA CÁC CƠ SỞ -->
                            <Grid x:Name="PnlBranchListView" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header + Nút Tạo mới -->
                                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="DANH SÁCH BIÊN BẢN BÀN GIAO THEO CƠ SỞ" FontWeight="Black" FontSize="14" Foreground="#000000"/>
                                            <TextBlock Text="Mỗi cơ sở sở hữu một cấu trúc biên bản bán hàng riêng (Tiền két đầu ca, Ngân hàng nhận, App POS bán hàng)." 
                                                       Foreground="#444444" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="+ TẠO MỚI BIÊN BẢN CƠ SỞ" Style="{StaticResource PrimaryBlackButton}" 
                                                Padding="18,10" FontWeight="Bold" FontSize="12.5" Click="BtnOpenCreateBranch_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Bảng danh sách cơ sở & cấu hình -->
                                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14">
                                    <DataGrid x:Name="DgBranchHandoverList" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="1" BorderBrush="#000000">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã CS" Binding="{Binding BranchId}" Width="65" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Tên Cơ Sở Bán Hàng" Binding="{Binding BranchName}" Width="200" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Tiền Két Đầu Ca" Binding="{Binding DefaultCashOpeningDisplay}" Width="130"/>
                                            <DataGridTextColumn Header="Ngân Hàng Nhận (Chuyển khoản)" Binding="{Binding BankSummary}" Width="220"/>
                                            <DataGridTextColumn Header="App POS Bán Hàng" Binding="{Binding PosSummary}" Width="190"/>
                                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" Width="110"/>
                                            <DataGridTemplateColumn Header="Hành Động" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Sửa cấu hình" Style="{StaticResource PrimaryBlackButton}" 
                                                                    Padding="12,5" Margin="0,0,6,0" Click="BtnEditBranchHandover_Click"/>
                                                            <Button Content="{Binding ToggleLockContent}" Style="{StaticResource OutlineButton}" 
                                                                    Padding="10,5" Click="BtnToggleBranchActive_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>

                            <!-- VIEW 2: FORM CHI TIẾT TẠO MỚI / CHỈNH SỬA BIÊN BẢN CƠ SỞ -->
                            <ScrollViewer x:Name="PnlBranchFormView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel Margin="0,0,0,16">

                                    <!-- Thanh điều hướng quay lại & Tiêu đề Form -->
                                    <Border Background="#000000" CornerRadius="6" Padding="18,12" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Content="← QUAY LẠI DANH SÁCH" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold"
                                                    BorderThickness="0" Padding="14,6" Cursor="Hand" Click="BtnBackToList_Click"/>

                                            <TextBlock Grid.Column="1" x:Name="TxtFormHeaderTitle" Text="CẤU HÌNH BIÊN BẢN BÀN GIAO CHỐT CA" 
                                                       FontWeight="Black" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="16,0,0,0"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="HỦY BỎ" Background="Transparent" Foreground="#FFFFFF" BorderBrush="#FFFFFF" BorderThickness="1"
                                                        Padding="14,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnBackToList_Click"/>
                                                <Button Content="LƯU BIÊN BẢN CƠ SỞ" Background="#FFFFFF" Foreground="#000000" FontWeight="Black"
                                                        BorderThickness="0" Padding="18,6" Cursor="Hand" Click="BtnSaveBranchHandover_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 1. THÔNG TIN CƠ SỞ & TIỀN ĐẦU CA -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="1. THÔNG TIN CƠ SỞ BÁN HÀNG &amp; TIỀN MẶT ĐẦU CA" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock Text="Cơ sở được cấp mã riêng và áp dụng mức tiền mặt két cố định khi mở ca mới." Foreground="#555555" FontSize="11.5" Margin="0,0,0,14"/>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="340"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tên cơ sở bán hàng:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtFormBranchName" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#000000" BorderThickness="1.5"/>
                                                <CheckBox x:Name="ChkFormBranchActive" Grid.Column="2" Content="Đang hoạt động (cho phép mở ca)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="340"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tiền két mặc định đầu ca (VNĐ):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtFormCashOpening" Grid.Column="1" Text="2,000,000" Height="34" VerticalContentAlignment="Center" Padding="10,0" FontWeight="Bold" FontSize="13" BorderBrush="#000000" BorderThickness="1.5"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. CẤU HÌNH NGÂN HÀNG NHẬN (CHUYỂN KHOẢN) -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="2. CẤU HÌNH NGÂN HÀNG / VÍ NHẬN TIỀN (CHUYỂN KHOẢN)" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock Text="Các tài khoản ngân hàng / ví điện tử được cấu hình riêng cho cơ sở này khi nhận tiền khách chuyển khoản." Foreground="#555555" FontSize="11.5" Margin="0,0,0,14"/>

                                            <!-- DataGrid Ngân hàng -->
                                            <DataGrid x:Name="DgFormBanks" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="1" BorderBrush="#000000" Margin="0,0,0,12">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Cổng (Slot)" Binding="{Binding SlotIndex}" Width="90"/>
                                                    <DataGridTextColumn Header="Tên Ngân hàng / Ví Điện tử" Binding="{Binding BankName}" Width="*"/>
                                                    <DataGridCheckBoxColumn Header="Kích hoạt sử dụng" Binding="{Binding IsActive}" Width="140"/>
                                                    <DataGridTemplateColumn Header="Thao tác" Width="90">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Xóa" Style="{StaticResource OutlineButton}" Padding="8,2" Click="BtnDeleteFormBank_Click"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Thêm ngân hàng nhanh -->
                                            <Border Background="#F9F9F9" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtNewFormBankName" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0" BorderBrush="#000000" BorderThickness="1" ToolTip="Nhập tên ngân hàng/ví mới (ví dụ: MbBank, Techcombank)"/>
                                                    <TextBox x:Name="TxtNewFormBankSlot" Grid.Column="1" Text="1" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0" BorderBrush="#000000" BorderThickness="1" ToolTip="Số cổng (1, 2...)"/>
                                                    <CheckBox x:Name="ChkNewFormBankActive" Grid.Column="2" Content="Kích hoạt dùng" FontWeight="SemiBold" VerticalAlignment="Center" IsChecked="True"/>
                                                    <Button Grid.Column="3" Content="+ Thêm Ngân hàng" Style="{StaticResource OutlineButton}" Padding="14,6" Click="BtnAddFormBank_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. CẤU HÌNH APP POS BÁN HÀNG -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="3. CẤU HÌNH PHẦN MỀM BÁN HÀNG (APP POS)" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock Text="Các app quản lý bán hàng / máy POS (Sapo POS, KiotViet, Master,...) sử dụng tại cơ sở này." Foreground="#555555" FontSize="11.5" Margin="0,0,0,14"/>

                                            <!-- DataGrid POS -->
                                            <DataGrid x:Name="DgFormPos" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="1" BorderBrush="#000000" Margin="0,0,0,12">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Thứ tự" Binding="{Binding DisplayOrder}" Width="80"/>
                                                    <DataGridTextColumn Header="Tên Phần Mềm POS" Binding="{Binding PosName}" Width="*"/>
                                                    <DataGridCheckBoxColumn Header="Kích hoạt sử dụng" Binding="{Binding IsActive}" Width="140"/>
                                                    <DataGridTemplateColumn Header="Thao tác" Width="90">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Xóa" Style="{StaticResource OutlineButton}" Padding="8,2" Click="BtnDeleteFormPos_Click"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Thêm POS nhanh -->
                                            <Border Background="#F9F9F9" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtNewFormPosName" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0" BorderBrush="#000000" BorderThickness="1" ToolTip="Nhập tên phần mềm POS mới"/>
                                                    <TextBox x:Name="TxtNewFormPosOrder" Grid.Column="1" Text="1" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0" BorderBrush="#000000" BorderThickness="1" ToolTip="Thứ tự hiển thị (1, 2...)"/>
                                                    <CheckBox x:Name="ChkNewFormPosActive" Grid.Column="2" Content="Kích hoạt dùng" FontWeight="SemiBold" VerticalAlignment="Center" IsChecked="True"/>
                                                    <Button Grid.Column="3" Content="+ Thêm máy POS" Style="{StaticResource OutlineButton}" Padding="14,6" Click="BtnAddFormPos_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- NÚT LƯU CUỐI TRANG -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="16,14">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Hủy bỏ &amp; Quay lại" Style="{StaticResource OutlineButton}" Padding="18,10" Margin="0,0,12,0" Click="BtnBackToList_Click"/>
                                            <Button Content="LƯU CẤU HÌNH BIÊN BẢN CƠ SỞ" Style="{StaticResource PrimaryBlackButton}" Padding="24,10" FontWeight="Bold" FontSize="13" Click="BtnSaveBranchHandover_Click"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
