                                                    </Grid>
                                                </Border>
                                                <!-- VÙNG 1: TIỀN MẶT TẠI KÉT -->
                                                <TextBlock Text="1. TIỀN MẶT TẠI KÉT" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                                                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,14" TextElement.Foreground="#000000">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="1"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Đầu ca -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Đầu ca (tiền mồi két):" FontWeight="SemiBold" Foreground="#000000" Margin="0,4"/>
                                                        <TextBlock x:Name="TxtDetailCashOpening" Grid.Row="0" Grid.Column="1" Text="0 đ" FontWeight="Black" Foreground="#000000" Margin="0,4"/>
                                                        <!-- Hết ca -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hết ca (tiền kiểm đếm):" FontWeight="SemiBold" Foreground="#000000" Margin="0,4"/>
                                                        <TextBlock x:Name="TxtDetailCashClosing" Grid.Row="1" Grid.Column="1" Text="0 đ" FontWeight="Black" Foreground="#000000" Margin="0,4"/>
                                                        <!-- Kẻ phân cách -->
                                                        <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Fill="#000000" Margin="0,8"/>
                                                        <!-- Tổng âm/dương so với ban đầu -->
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Chênh lệch tiền mặt tại két:" FontWeight="Black" FontSize="13" Foreground="#000000" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                                        <TextBlock x:Name="TxtDetailCashDiff" Grid.Row="3" Grid.Column="1" Text="0 đ" FontWeight="Black" FontSize="14" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                                    </Grid>
                                                </Border>
                                                <!-- VÙNG 2: DOANH SỐ BÁN HÀNG QUA MÁY POS -->
                                                <TextBlock Text="2. DOANH SỐ BÁN HÀNG QUA MÁY POS" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                                                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,14" TextElement.Foreground="#000000">
                                                    <StackPanel>
                                                        <!-- Máy POS 1 -->
                                                        <Border x:Name="PnlDetailPos1Group" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0">
                                                                    <TextBlock x:Name="TxtDetailPos1Label" Text="Máy POS 1 (Sapo POS)" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                                    <TextBlock x:Name="TxtDetailPos1Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <TextBlock x:Name="TxtDetailPos1Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Máy POS 2 -->
                                                        <Border x:Name="PnlDetailPos2Group" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0">
                                                                    <TextBlock x:Name="TxtDetailPos2Label" Text="Máy POS 2 (KiotViet)" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                                    <TextBlock x:Name="TxtDetailPos2Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <TextBlock x:Name="TxtDetailPos2Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Máy POS 3 -->
                                                        <Border x:Name="PnlDetailPos3Group" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA" Visibility="Collapsed">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0">
                                                                    <TextBlock x:Name="TxtDetailPos3Label" Text="Máy POS 3" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                                    <TextBlock x:Name="TxtDetailPos3Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <TextBlock x:Name="TxtDetailPos3Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Thông báo khi ca không sử dụng POS -->
                                                        <TextBlock x:Name="TxtDetailNoPosNotice" Text="(Ca này nhân viên không sử dụng máy POS bán hàng)" FontSize="11" FontStyle="Italic" Foreground="#666666" Margin="0,2,0,8" Visibility="Collapsed"/>
                                                        <!-- Tổng doanh số POS -->
                                                        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                                            <Grid>
                                                                <TextBlock Text="TỔNG DOANH SỐ BÁN HÀNG QUA POS:" FontWeight="Black" FontSize="12" Foreground="#000000"/>
                                                                <TextBlock x:Name="TxtDetailTotalPos" Text="0 đ" FontWeight="Black" FontSize="13" Foreground="#000000" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border></StackPanel>
                                                </Border>
                                                <!-- VÙNG 3: DOANH THU CHUYỂN KHOẢN & NGÂN HÀNG -->
                                                <TextBlock Text="3. DOANH THU CHUYỂN KHOẢN &amp; NGÂN HÀNG" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                                                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,14" TextElement.Foreground="#000000">
                                                    <StackPanel>
                                                        <!-- Ngân hàng 1 -->
                                                        <Border x:Name="PnlDetailBank1Group" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0">
                                                                    <TextBlock x:Name="TxtDetailBank1Label" Text="Ngân hàng 1 (TingTing)" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                                    <TextBlock x:Name="TxtDetailBank1Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <TextBlock x:Name="TxtDetailBank1Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Ngân hàng 2 -->
                                                        <Border x:Name="PnlDetailBank2Group" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0">
                                                                    <TextBlock x:Name="TxtDetailBank2Label" Text="Ngân hàng 2 (Zalo Pay)" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                                    <TextBlock x:Name="TxtDetailBank2Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <TextBlock x:Name="TxtDetailBank2Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Ngân hàng 3 -->
                                                        <Border x:Name="PnlDetailBank3Group" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F8F9FA" Visibility="Collapsed">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0">
                                                                    <TextBlock x:Name="TxtDetailBank3Label" Text="Ngân hàng 3" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                                                                    <TextBlock x:Name="TxtDetailBank3Diff" Text="+0 đ" FontWeight="Black" FontSize="12" Foreground="#000000" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <TextBlock x:Name="TxtDetailBank3Breakdown" Grid.Row="1" Text="Đầu ca: 0 đ  |  Cuối ca: 0 đ" FontSize="11" Foreground="#444444" Margin="0,4,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Thông báo khi ca không sử dụng Ngân hàng -->
                                                        <TextBlock x:Name="TxtDetailNoBankNotice" Text="(Ca này nhân viên không sử dụng ngân hàng chuyển khoản)" FontSize="11" FontStyle="Italic" Foreground="#666666" Margin="0,2,0,8" Visibility="Collapsed"/>
                                                        <!-- Tổng doanh thu ngân hàng -->
                                                        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                                            <Grid>
                                                                <TextBlock Text="TỔNG TIỀN CHUYỂN KHOẢN &amp; NGÂN HÀNG:" FontWeight="Black" FontSize="12" Foreground="#000000"/>
                                                                <TextBlock x:Name="TxtDetailTotalBank" Text="0 đ" FontWeight="Black" FontSize="13" Foreground="#000000" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border></StackPanel>
                                                </Border>
                                                <!-- VÙNG 4: KHOẢN CHI XUẤT KÉT TRONG CA -->
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="4. CÁC KHOẢN CHI XUẤT KÉT TRONG CA" FontWeight="Black" FontSize="12" Foreground="#000000" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtDetailExpenseSummary" Text="Tổng đã chi: 0 đ" FontWeight="Bold" FontSize="11" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="10" Margin="0,0,0,14" TextElement.Foreground="#000000">
                                                    <StackPanel>
                                                        <ItemsControl x:Name="IcDetailExpenses">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#F8F9FA" BorderBrush="#000000" BorderThickness="1" Padding="10,7" CornerRadius="3" Margin="0,0,0,5">
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="11" Foreground="#000000" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding AmountDisplay}" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock x:Name="TxtNoExpensesNotice" Text="Không có khoản chi xuất két nào trong ca này." FontStyle="Italic" FontSize="11" Foreground="#555555" Visibility="Collapsed"/></StackPanel>
                                                </Border>
                                                <!-- VÙNG 5: GHI CHÚ VÀ GIẢI TRÌNH CỦA NHÂN VIÊN -->
                                                <TextBlock Text="5. GHI CHÚ &amp; GIẢI TRÌNH CỦA NHÂN VIÊN CHỐT CA" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                                                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="12" TextElement.Foreground="#000000">
                                                    <TextBlock x:Name="TxtDetailNote" Text="Không có ghi chú"
                                                       FontStyle="Italic" TextWrapping="Wrap" Foreground="#000000" LineHeight="18"/>
                                                </Border></StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <!-- SUB-TAB 2: NHÂN VIÊN (TRA CỨU THEO NHÂN VIÊN) -->
                    <TabItem Header="Nhân viên" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Thanh bộ lọc nhân sự: Khoảng thời gian (Từ ngày, Đến ngày) & Tìm kiếm nhân viên -->
                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Lọc Từ ngày -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Từ ngày:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <DatePicker x:Name="DpLookupEmpFromDate" Width="125" Height="32"/></StackPanel>
                                    <!-- Lọc Đến ngày -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Đến ngày:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <DatePicker x:Name="DpLookupEmpToDate" Width="125" Height="32"/></StackPanel>
                                    <!-- Tìm kiếm nhân viên -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Tìm kiếm:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtSearchLookupEmp" Width="180" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1" TextChanged="TxtSearchLookupEmp_TextChanged"/></StackPanel>
                                    <!-- Nút Lọc & Đặt lại -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Lọc dữ liệu" Style="{StaticResource PrimaryBlackButton}" Margin="0,0,8,0" Click="BtnFilterLookupEmpDate_Click"/>
                                        <Button Content="Đặt lại" Style="{StaticResource OutlineButton}" Click="BtnResetLookupEmpDate_Click"/></StackPanel>
                                    <!-- Đếm số nhân sự -->
                                    <TextBlock x:Name="TxtLookupEmpCount" Grid.Column="5" Text="Tổng số nhân sự: 0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Khối 2 cột: Cột trái là Danh sách nhân viên, Cột phải là Lịch sử ca làm của nhân viên đó -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4.5*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="5.5*"/>
                                </Grid.ColumnDefinitions>
                                <!-- CỘT TRÁI: DANH SÁCH NHÂN SỰ -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                            <TextBlock Text="DANH SÁCH NHÂN SỰ (CHỌN ĐỂ XEM LỊCH SỬ CA)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                        <DataGrid x:Name="DgLookupEmployees" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="#FFFFFF"
                                                  BorderThickness="0" Margin="6" SelectionChanged="DgLookupEmployees_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="135"/>
                                                <DataGridTextColumn Header="Tài khoản" Binding="{Binding Username}" Width="95"/>
                                                <DataGridTextColumn Header="Tổng số ca" Binding="{Binding TotalShiftsDisplay}" Width="95"/>
                                                <DataGridTextColumn Header="Âm" Binding="{Binding TotalNegativeDiff}" Width="110"/>
                                                <DataGridTextColumn Header="Dương" Binding="{Binding TotalPositiveDiff}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                                <!-- CỘT PHẢI: LỊCH SỬ CÁC CA LÀM VIỆC CỦA NHÂN VIÊN ĐƯỢC CHỌN -->
                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Header cột phải -->
                                        <Border Grid.Row="0" Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                            <Grid>
                                                <TextBlock x:Name="TxtSelectedEmpHeader" Text="LỊCH SỬ CA LÀM CỦA NHÂN VIÊN" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock x:Name="TxtSelectedEmpShiftCount" Text="0 ca làm việc" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                        <!-- 3 Thẻ thống kê nhanh của nhân viên đang chọn -->
                                        <!-- 2 Thẻ thống kê nhanh của nhân viên đang chọn (Âm / Dương) -->
                                        <Grid Grid.Row="1" Margin="10,10,10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Thẻ 1: Ca Âm -->
                                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="TỔNG TIỀN ÂM" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                    <TextBlock x:Name="TxtSelectedEmpNegativeDiff" Text="0 đ" FontSize="16" FontWeight="Black" Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="TxtSelectedEmpNegativeCount" Text="0 ca bị hụt tiền" FontSize="10.5" Foreground="#555555"/></StackPanel>
                                            </Border>
                                            <!-- Thẻ 2: Ca Dương -->
                                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="TỔNG TIỀN DƯƠNG" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                    <TextBlock x:Name="TxtSelectedEmpPositiveDiff" Text="0 đ" FontSize="16" FontWeight="Black" Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="TxtSelectedEmpPositiveCount" Text="0 ca thừa tiền" FontSize="10.5" Foreground="#555555"/></StackPanel>
                                            </Border>
                                        </Grid>
                                        <!-- Bảng ca làm việc của nhân viên này -->
                                        <DataGrid x:Name="DgEmployeeShiftsDetail" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="#FFFFFF"
                                                  BorderThickness="0" Margin="6" MouseDoubleClick="DgEmployeeShiftsDetail_MouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Mã Ca" Binding="{Binding ShiftId}" Width="65"/>
                                                <DataGridTextColumn Header="Ngày" Binding="{Binding ShiftDate}" Width="90"/>
                                                <DataGridTextColumn Header="Ca" Binding="{Binding ShiftType}" Width="80"/>
                                                <DataGridTextColumn Header="Cơ sở" Binding="{Binding BranchName}" Width="1.5*"/>
                                                <DataGridTextColumn Header="Nhân viên trực" Binding="{Binding EmployeeNames}" Width="2*"/>
                                                <DataGridTextColumn Header="Chênh lệch" Binding="{Binding CashDifference}" Width="110"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <!-- SUB-TAB 3: TIỀN CHI TRONG CA (CẢNH BÁO GIAN LẬN & CHI PHÍ KÉT) -->
                    <TabItem Header="Tiền chi trong ca" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Row 0: 3 Thẻ thống kê (Cards) -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Card 1 -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="TỔNG TIỀN KÉT ĐÃ CHI TRONG THÁNG" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtExpenseTotalAmount" Text="0 đ" FontSize="22" FontWeight="Black" Foreground="#000000" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtExpenseTotalCount" Text="Tổng cộng: 0 phiếu xuất két" FontSize="11" Foreground="#000000" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                                <!-- Card 2 -->
                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="CA LỆCH TIỀN VƯỢT HẠN MỨC" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtExpenseAlertCount" Text="0 Ca Cảnh Báo" FontSize="22" FontWeight="Black" Foreground="#000000" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtExpenseAlertSub" Text="Lệch tiền cần đối soát" FontSize="11" Foreground="#000000" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                                <!-- Card 3 -->
                                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="KHOẢN CHI LỚN NHẤT ĐÃ XUẤT" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtExpenseMaxAmount" Text="0 đ" FontSize="22" FontWeight="Black" Foreground="#000000" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtExpenseMaxDesc" Text="Khoản chi lớn nhất trong danh sách" FontSize="11" Foreground="#000000" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                            </Grid>
                            <!-- Row 1: THANH BỘ LỌC (Cơ sở bán hàng, Tên nhân viên, Tìm kiếm lý do, Nút Lọc & Đặt lại) -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Lọc Cơ sở bán hàng -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Cơ sở:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CbExpenseFilterBranch" Width="150" Height="32" VerticalContentAlignment="Center" SelectionChanged="ExpenseFilter_Changed"/></StackPanel>
                                    <!-- Lọc Tên Nhân viên -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Nhân viên:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CbExpenseFilterEmployee" Width="160" Height="32" VerticalContentAlignment="Center" SelectionChanged="ExpenseFilter_Changed"/></StackPanel>
                                    <!-- Tìm kiếm từ khóa (Lý do, Ghi chú) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Tìm kiếm:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtSearchExpense" Width="180" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1" KeyDown="TxtSearchExpense_KeyDown"/></StackPanel>
                                    <!-- Nút Lọc & Đặt lại -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Lọc dữ liệu" Style="{StaticResource PrimaryBlackButton}" Margin="0,0,8,0" Click="BtnFilterExpenses_Click"/>
                                        <Button Content="Đặt lại" Style="{StaticResource OutlineButton}" Click="BtnResetExpenseFilter_Click"/></StackPanel>
                                    <!-- Đếm số lượng phiếu -->
                                    <TextBlock x:Name="TxtExpenseFilterCount" Grid.Column="5" Text="Hiển thị: 0 phiếu chi" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Row 2: Bảng soát xét chi phí két -->
                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                        <TextBlock Text="LỊCH SỬ XUẤT TIỀN KÉT ĐỂ ĐỐI SOÁT VỚI HÓA ĐƠN THỰC TẾ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Border>
                                    <DataGrid x:Name="DgExpenses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="0" Margin="8"
                                              HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding Id}" Width="75"/>
                                            <DataGridTextColumn Header="Mã Ca" Binding="{Binding ShiftId}" Width="185"/>
                                            <DataGridTextColumn Header="Cơ sở" Binding="{Binding BranchName}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Thời gian chi" Binding="{Binding CreatedAt}" Width="135"/>
                                            <DataGridTextColumn Header="Người bán trong ca" Binding="{Binding EmployeeNames}" Width="2.5*"/>
                                            <DataGridTextColumn Header="Số tiền xuất két" Binding="{Binding Amount}" Width="130"/>
                                            <DataGridTextColumn Header="Lý do chi" Binding="{Binding Description}" Width="3.5*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <!-- ============================================================== -->
            <!-- TAB 4: CÀI ĐẶT & THIẾT LẬP HỆ THỐNG (SETTINGS)                 -->
            <!-- ============================================================== -->
            <TabItem x:Name="TabSystemSettings" Header="CÀI ĐẶT HỆ THỐNG" Style="{StaticResource ModernTabItem}">
                <TabControl x:Name="TcSettingsTabs" Style="{StaticResource SidebarTabControl}" Margin="0,12,0,0">
                    <!-- SUB-TAB 1: QUẢN LÝ NHÂN VIÊN -->
                    <TabItem Header="Quản lý Nhân viên" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tìm kiếm nhân viên:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtSearchEmployee" Width="240" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,12,0" BorderBrush="#000000" BorderThickness="1"/>
                                        <Button Content="Tìm kiếm" Style="{StaticResource PrimaryBlackButton}" Click="BtnSearchEmployee_Click"/></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Xuất dữ liệu" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="BtnExportEmployees_Click"/>
                                        <Button Content="Thêm nhân viên mới" Style="{StaticResource PrimaryBlackButton}" Margin="0,0,8,0" Click="BtnAddEmployee_Click"/>
                                        <Button Content="Làm mới" Style="{StaticResource OutlineButton}" Click="BtnRefreshEmployees_Click"/></StackPanel>
                                </Grid>
                            </Border>
                            <!-- Bảng nhân viên -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                        <Grid>
                                            <TextBlock Text="DANH SÁCH NHÂN SỰ &amp; THEO DÕI CHÊNH LỆCH TIỀN BÁN" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock x:Name="TxtEmployeeCountHeader" Text="Dữ liệu nhân sự trực quầy" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <DataGrid x:Name="DgEmployees" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="0" Margin="8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã NV" Binding="{Binding Id}" Width="60"/>
                                            <DataGridTextColumn Header="Tên tài khoản" Binding="{Binding Username}" Width="110"/>
                                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="150"/>
                                            <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="80"/>
                                            <DataGridTextColumn Header="Số ca đã làm" Binding="{Binding ShiftCount}" Width="95"/>
                                            <DataGridTextColumn Header="Số ca Âm" Binding="{Binding NegativeShiftCount}" Width="80"/>
                                            <DataGridTextColumn Header="Tổng tiền Âm" Binding="{Binding TotalNegativeDiff}" Width="115"/>
                                            <DataGridTextColumn Header="Số ca Dương" Binding="{Binding PositiveShiftCount}" Width="85"/>
                                            <DataGridTextColumn Header="Tổng tiền Dương" Binding="{Binding TotalPositiveDiff}" Width="120"/>
                                            <DataGridTextColumn Header="Số ca Khớp" Binding="{Binding BalancedShiftCount}" Width="85"/>
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding IsActive}" Width="90"/>
                                            <DataGridTemplateColumn Header="Hành động" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Sửa" Style="{StaticResource PrimaryBlackButton}" Padding="8,3" Margin="0,0,6,0" Click="BtnEditEmployee_Click"/>
                                                            <Button Content="Khóa / Mở" Style="{StaticResource OutlineButton}" Padding="8,3" Margin="0,0,6,0" Click="BtnToggleLockEmployee_Click"/>
                                                            <Button Content="Xóa" Style="{StaticResource OutlineButton}" Padding="8,3" BorderBrush="#B91C1C" Click="BtnDeleteEmployee_Click"/></StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <!-- SUB-TAB 3: TẠO BIÊN BẢN (DANH SÁCH CƠ SỞ & CẤU HÌNH BIÊN BẢN CHỐT CA CHI TIẾT) -->
                    <TabItem Header="Tạo biên bản" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,4,0,0">
                            <!-- VIEW 1: DANH SÁCH BIÊN BẢN CỦA CÁC CƠ SỞ -->
                            <Grid x:Name="PnlBranchListView" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Header + Nút Tạo mới -->
                                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="DANH SÁCH BIÊN BẢN BÀN GIAO THEO CƠ SỞ" FontWeight="Black" FontSize="14" Foreground="#000000"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ TẠO MỚI BIÊN BẢN CƠ SỞ" Style="{StaticResource PrimaryBlackButton}" 
                                                Padding="18,10" FontWeight="Bold" FontSize="12.5" Click="BtnOpenCreateBranch_Click"/>
                                    </Grid>
                                </Border>
                                <!-- Bảng danh sách cơ sở & cấu hình -->
                                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14">
                                    <DataGrid x:Name="DgBranchHandoverList" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="1" BorderBrush="#000000">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã CS" Binding="{Binding BranchId}" Width="65" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Tên Cơ Sở Bán Hàng" Binding="{Binding BranchName}" Width="200" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Tiền Két Đầu Ca" Binding="{Binding DefaultCashOpeningDisplay}" Width="130"/>
                                            <DataGridTextColumn Header="Ngân Hàng Nhận (Chuyển khoản)" Binding="{Binding BankSummary}" Width="220"/>
                                            <DataGridTextColumn Header="App POS Bán Hàng" Binding="{Binding PosSummary}" Width="190"/>
                                            <DataGridTemplateColumn Header="Trạng Thái" Width="135">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Hành Động" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Sửa cấu hình" Style="{StaticResource PrimaryBlackButton}" 
                                                                    Padding="12,5" Margin="0,0,6,0" Click="BtnEditBranchHandover_Click"/>
                                                            <Button Content="{Binding ToggleLockContent}" Style="{StaticResource OutlineButton}" 
                                                                    Padding="10,5" Click="BtnToggleBranchActive_Click"/></StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                            <!-- VIEW 2: FORM CHI TIẾT TẠO MỚI / CHỈNH SỬA BIÊN BẢN CƠ SỞ -->
                            <ScrollViewer x:Name="PnlBranchFormView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel Margin="0,0,0,16">
                                    <!-- Thanh điều hướng quay lại & Tiêu đề Form -->
                                    <Border Background="#000000" CornerRadius="6" Padding="18,12" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="← QUAY LẠI DANH SÁCH" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold"
                                                    BorderThickness="0" Padding="14,6" Cursor="Hand" Click="BtnBackToList_Click"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtFormHeaderTitle" Text="CẤU HÌNH BIÊN BẢN BÀN GIAO CHỐT CA" 
                                                       FontWeight="Black" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                 <Button Content="HỦY BỎ" Background="#B91C1C" Foreground="#FFFFFF" BorderBrush="#DC2626" BorderThickness="1"
                                                         Padding="14,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnBackToList_Click"/>
                                                 <Button Content="LƯU BIÊN BẢN CƠ SỞ" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Black"
                                                         BorderThickness="0" Padding="18,6" Cursor="Hand" Click="BtnSaveBranchHandover_Click"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- 1. THÔNG TIN CƠ SỞ & TIỀN ĐẦU CA -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="1. THÔNG TIN CƠ SỞ BÁN HÀNG &amp; TIỀN MẶT ĐẦU CA" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock Text="Cơ sở được cấp mã riêng và áp dụng mức tiền mặt két cố định khi mở ca mới." Foreground="#555555" FontSize="11.5" Margin="0,0,0,14"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="340"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tên cơ sở bán hàng:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtFormBranchName" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#000000" BorderThickness="1.5"/>
                                                <CheckBox x:Name="ChkFormBranchActive" Grid.Column="2" Content="Đang hoạt động (cho phép mở ca)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="340"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tiền két mặc định đầu ca (VNĐ):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtFormCashOpening" Grid.Column="1" Text="2,000,000" Height="34" VerticalContentAlignment="Center" Padding="10,0" FontWeight="Bold" FontSize="13" BorderBrush="#000000" BorderThickness="1.5"/>
                                            </Grid></StackPanel>
                                    </Border>
                                    <!-- 2. CẤU HÌNH NGÂN HÀNG NHẬN (CHUYỂN KHOẢN) -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="2. CẤU HÌNH NGÂN HÀNG / VÍ NHẬN TIỀN (CHUYỂN KHOẢN)" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock Text="Các tài khoản ngân hàng / ví điện tử được cấu hình riêng cho cơ sở này khi nhận tiền khách chuyển khoản (Tối đa 3 ngân hàng / ví điện tử)." Foreground="#555555" FontSize="11.5" Margin="0,0,0,14"/>
                                            <!-- DataGrid Ngân hàng -->
                                            <DataGrid x:Name="DgFormBanks" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="1" BorderBrush="#000000" Margin="0,0,0,12">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Logo" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Width="30" Height="30" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource ServerImageConverter}}" Stretch="Uniform" Margin="2"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Cổng (Slot)" Binding="{Binding SlotIndex}" Width="90"/>
                                                    <DataGridTextColumn Header="Tên Ngân hàng / Ví Điện tử" Binding="{Binding BankName}" Width="*"/>
                                                    <DataGridCheckBoxColumn Header="Kích hoạt sử dụng" Binding="{Binding IsActive}" Width="140"/>
                                                    <DataGridTemplateColumn Header="Thao tác" Width="140">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="Đổi ảnh" Style="{StaticResource OutlineButton}" Padding="8,2" Margin="0,0,4,0" Click="BtnChangeBankLogo_Click"/>
                                                                    <Button Content="Xóa" Style="{StaticResource OutlineButton}" Padding="8,2" Click="BtnDeleteFormBank_Click"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <!-- Thêm ngân hàng nhanh -->
                                            <Border Background="#F9F9F9" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtNewFormBankName" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0" BorderBrush="#000000" BorderThickness="1" ToolTip="Nhập tên ngân hàng/ví mới (ví dụ: MbBank, Techcombank)"/>
                                                    <TextBox x:Name="TxtNewFormBankSlot" Grid.Column="1" Text="1" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0" BorderBrush="#000000" BorderThickness="1" ToolTip="Số cổng (1, 2...)"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Border Width="32" Height="32" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Margin="0,0,6,0">
                                                            <Image x:Name="ImgNewFormBankPreview" Stretch="Uniform" Margin="2"/>
                                                        </Border>
                                                        <Button Content="Chọn ảnh..." Style="{StaticResource OutlineButton}" Padding="8,4" Click="BtnPickNewBankLogo_Click"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkNewFormBankActive" Grid.Column="3" Content="Kích hoạt dùng" FontWeight="SemiBold" VerticalAlignment="Center" IsChecked="True"/>
                                                    <Button Grid.Column="4" Content="+ Thêm Ngân hàng" Style="{StaticResource OutlineButton}" Padding="14,6" Click="BtnAddFormBank_Click"/>
                                                </Grid>
                                            </Border></StackPanel>
                                    </Border>
                                    <!-- 3. CẤU HÌNH APP POS BÁN HÀNG -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="3. CẤU HÌNH PHẦN MỀM BÁN HÀNG (APP POS)" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock Text="Các app quản lý bán hàng / máy POS (Sapo POS, KiotViet,...) sử dụng tại cơ sở này (Tối đa 3 máy POS)." Foreground="#555555" FontSize="11.5" Margin="0,0,0,14"/>
                                            <!-- DataGrid POS -->
                                            <DataGrid x:Name="DgFormPos" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="1" BorderBrush="#000000" Margin="0,0,0,12">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Logo" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Width="30" Height="30" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource ServerImageConverter}}" Stretch="Uniform" Margin="2"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Thứ tự" Binding="{Binding DisplayOrder}" Width="80"/>
                                                    <DataGridTextColumn Header="Tên Phần Mềm POS" Binding="{Binding PosName}" Width="*"/>
                                                    <DataGridCheckBoxColumn Header="Kích hoạt sử dụng" Binding="{Binding IsActive}" Width="140"/>
                                                    <DataGridTemplateColumn Header="Thao tác" Width="140">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="Đổi ảnh" Style="{StaticResource OutlineButton}" Padding="8,2" Margin="0,0,4,0" Click="BtnChangePosLogo_Click"/>
                                                                    <Button Content="Xóa" Style="{StaticResource OutlineButton}" Padding="8,2" Click="BtnDeleteFormPos_Click"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <!-- Thêm POS nhanh -->
                                            <Border Background="#F9F9F9" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtNewFormPosName" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0" BorderBrush="#000000" BorderThickness="1" ToolTip="Nhập tên phần mềm POS mới"/>
                                                    <TextBox x:Name="TxtNewFormPosOrder" Grid.Column="1" Text="1" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0" BorderBrush="#000000" BorderThickness="1" ToolTip="Thứ tự hiển thị (1, 2...)"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Border Width="32" Height="32" BorderBrush="#000000" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Margin="0,0,6,0">
                                                            <Image x:Name="ImgNewFormPosPreview" Stretch="Uniform" Margin="2"/>
                                                        </Border>
                                                        <Button Content="Chọn ảnh..." Style="{StaticResource OutlineButton}" Padding="8,4" Click="BtnPickNewPosLogo_Click"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkNewFormPosActive" Grid.Column="3" Content="Kích hoạt dùng" FontWeight="SemiBold" VerticalAlignment="Center" IsChecked="True"/>
                                                    <Button Grid.Column="4" Content="+ Thêm máy POS" Style="{StaticResource OutlineButton}" Padding="14,6" Click="BtnAddFormPos_Click"/>
                                                </Grid>
                                            </Border></StackPanel>
                                    </Border>
                                    <!-- NÚT LƯU CUỐI TRANG -->
                                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="16,14">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Hủy bỏ &amp; Quay lại" Style="{StaticResource OutlineButton}" Padding="18,10" Margin="0,0,12,0" Click="BtnBackToList_Click"/>
                                            <Button Content="LƯU CẤU HÌNH BIÊN BẢN CƠ SỞ" Style="{StaticResource PrimaryBlackButton}" Padding="24,10" FontWeight="Bold" FontSize="13" Click="BtnSaveBranchHandover_Click"/></StackPanel>
                                    </Border></StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- SUB-TAB 3: RESET HỆ THỐNG (LỌC VÀ XÓA DỮ LIỆU GIAO DỊCH CA LÀM VIỆC) -->
                    <TabItem Header="Reset Hệ Thống" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header + Bộ lọc -->
                                <RowDefinition Height="*"/>    <!-- DataGrid danh sách ca -->
                            </Grid.RowDefinitions>

                            <!-- 1. HEADER VÀ BỘ LỌC KHOẢNG THỜI GIAN -->
                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="RESET DỮ LIỆU" FontWeight="Black" FontSize="15" Foreground="#DC2626" Margin="0,0,0,12"/>

                                    <!-- KHUNG BỘ LỌC -->
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Từ ngày:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <DatePicker x:Name="DpResetFromDate" Width="140" Height="32"/>

                                            <TextBlock Text="Đến ngày:" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                            <DatePicker x:Name="DpResetToDate" Width="140" Height="32"/>

                                            <TextBlock Text="Cơ sở:" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                            <ComboBox x:Name="CbResetBranch" Width="180" Height="32"/>

                                            <Button Content="Lọc ca làm việc" Style="{StaticResource PrimaryBlackButton}" Padding="16,6" Margin="14,0,0,0" Click="BtnFilterResetShifts_Click"/>
                                            <Button Content="Làm mới" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="8,0,0,0" Click="BtnRefreshResetShifts_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 2. DATAGRID DANH SÁCH CA TRONG KHOẢNG NGÀY ĐÃ LỌC + FOOTER THỐNG KÊ & XÁC NHẬN XÓA -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Tiêu đề bảng -->
                                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                                        <RowDefinition Height="Auto"/> <!-- Chân trang: Thống kê & Nút xác nhận xóa -->
                                    </Grid.RowDefinitions>

                                    <!-- Tiêu đề bảng -->
                                    <Border Background="#000000" CornerRadius="4,4,0,0" Padding="14,10">
                                        <Grid>
                                            <TextBlock Text="DANH SÁCH CÁC CA LÀM VIỆC THEO BỘ LỌC ĐÃ CHỌN" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock x:Name="TxtResetGridCount" Text="Hiển thị: 0 ca" Foreground="#CCCCCC" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <DataGrid x:Name="DgResetShifts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E5E7EB">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã Ca / Đơn" Binding="{Binding ShiftCode}" Width="150" FontWeight="SemiBold"/>
                                            <DataGridTextColumn Header="Ngày Làm" Binding="{Binding ShiftDateDisplay}" Width="110"/>
                                            <DataGridTextColumn Header="Ca Làm" Binding="{Binding ShiftTypeDisplay}" Width="95"/>
                                            <DataGridTextColumn Header="Cơ Sở" Binding="{Binding BranchName}" Width="150"/>
                                            <DataGridTextColumn Header="Người Phụ Trách" Binding="{Binding PersonInCharge}" Width="160"/>
                                            <DataGridTemplateColumn Header="Tiền Âm (Thiếu)" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding NegativeAmountDisplay}" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Tiền Dương (Thừa)" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding PositiveAmountDisplay}" Foreground="#16A34A" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Chân trang DataGrid: Thống kê & Nút xác nhận xóa dữ liệu -->
                                    <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0,0,4,4" Padding="14,10" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Dữ liệu thống kê số ca & tiền âm dương -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="12,7" Margin="0,0,10,0">
                                                    <TextBlock x:Name="TxtResetTotalShifts" Text="Tổng: 0 ca" FontWeight="Bold" Foreground="#1E40AF" FontSize="13"/>
                                                </Border>
                                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="12,7" Margin="0,0,10,0">
                                                    <TextBlock x:Name="TxtResetTotalNeg" Text="Tổng Âm: 0 đ" FontWeight="Bold" Foreground="#DC2626" FontSize="13"/>
                                                </Border>
                                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="12,7">
                                                    <TextBlock x:Name="TxtResetTotalPos" Text="Tổng Dương: 0 đ" FontWeight="Bold" Foreground="#16A34A" FontSize="13"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Nút xuất sao lưu & Nút xác nhận xóa -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnExportResetBackup" Content="📥 XUẤT SAO LƯU (EXCEL/CSV)" 
                                                        Background="#1E40AF" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5"
                                                        Padding="16,10" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0" Click="BtnExportResetBackup_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- Nút XÁC NHẬN XÓA DỮ LIỆU NÀY -->
                                                <Button x:Name="BtnConfirmResetData" Content="XÁC NHẬN XÓA DỮ LIỆU NÀY" 
                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="Black" FontSize="13"
                                                        Padding="20,10" Cursor="Hand" BorderThickness="0" Click="BtnConfirmResetData_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- SUB-TAB 4: TÀI KHOẢN ADMIN (ĐỔI TÀI KHOẢN & MẬT KHẨU QUẢN TRỊ VIÊN) -->
                    <TabItem Header="Tài khoản Admin" Style="{StaticResource SubTabItem}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="ĐỔI TÀI KHOẢN &amp; MẬT KHẨU QUẢN TRỊ VIÊN" FontWeight="Black" FontSize="15" Foreground="#DC2626"/>
                                    <TextBlock Text="Cập nhật tên đăng nhập, họ tên và mật khẩu của tài khoản Quản trị viên (Admin) dùng để đăng nhập và xác thực bảo mật hệ thống." 
                                               Foreground="#4B5563" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Form thay đổi thông tin -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="24,20" VerticalAlignment="Top" MaxWidth="640" HorizontalAlignment="Left">
                                <StackPanel>
                                    <!-- Nhóm 1: Xác thực mật khẩu cũ -->
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="1. XÁC THỰC QUẢN TRỊ VIÊN HIỆN TẠI" FontWeight="Bold" FontSize="12.5" Foreground="#000000" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tên đăng nhập hiện tại:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="TxtAdminCurUsername" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1.5"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Mật khẩu hiện tại:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <PasswordBox Grid.Column="1" x:Name="PbAdminCurPassword" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1.5"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Nhóm 2: Thông tin tài khoản mới -->
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="2. THÔNG TIN THAY ĐỔI MỚI" FontWeight="Bold" FontSize="12.5" Foreground="#000000" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tên đăng nhập mới:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="TxtAdminNewUsername" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1.5"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Họ và tên hiển thị:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="TxtAdminNewFullName" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1.5"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Mật khẩu mới:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <PasswordBox Grid.Column="1" x:Name="PbAdminNewPassword" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1.5"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nhập lại mật khẩu mới:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <PasswordBox Grid.Column="1" x:Name="PbAdminConfirmPassword" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#000000" BorderThickness="1.5"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Nút thao tác -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Đặt lại biểu mẫu" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="0,0,10,0" Click="BtnResetAdminAccountForm_Click"/>
                                        <Button x:Name="BtnSaveAdminAccount" Content="💾 LƯU THAY ĐỔI TÀI KHOẢN &amp; MẬT KHẨU" Style="{StaticResource PrimaryBlackButton}" 
                                                Padding="20,10" FontWeight="Black" FontSize="13" Click="BtnSaveAdminAccount_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
