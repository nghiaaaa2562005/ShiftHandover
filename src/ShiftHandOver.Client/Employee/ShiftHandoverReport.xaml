<Window x:Class="ShiftHandOver.Client.Employee.ShiftHandoverReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PLUS MART — BIÊN BẢN GIAO NHẬN VÀ CHỐT CA"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- Card Container Style (Đen Trắng) -->
        <Style x:Key="MainCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Header Ribbon cho khối chính -->
        <Style x:Key="MainCardHeader" TargetType="Border">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
        </Style>

        <Style x:Key="MainCardHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Header cho từng nhóm con bên trong -->
        <Style x:Key="SubSectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
        </Style>

        <Style x:Key="SubSectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Box bao quanh từng nhóm con -->
        <Style x:Key="SubSectionBox" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Header của bảng con -->
        <Style x:Key="TableHeader" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Nhãn trường dữ liệu thông thường -->
        <Style x:Key="ItemLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style ô nhập tiền (Active - Đen Trắng) -->
        <Style x:Key="MoneyInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <!-- Style ô số liệu BỊ KHÓA -->
        <Style x:Key="MoneyLocked" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- Style ô số liệu TÍNH TỰ ĐỘNG -->
        <Style x:Key="MoneyCalculated" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- LỚP GIAO DIỆN CHÍNH (CÓ THANH CUỘN CHỐNG TRÀN VÀ ĐÈ CHỮ) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16" MinWidth="1050">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 1. Header điều hướng ca -->
                    <RowDefinition Height="Auto"/> <!-- 2. Nội dung 2 Khối: Trái (Nhập liệu) và Phải (Tổng kết) -->
                    <RowDefinition Height="Auto"/> <!-- 3. Footer bàn giao & nút thao tác -->
                </Grid.RowDefinitions>

            <!-- ========================================================== -->
            <!-- 1. TOP HEADER: THÔNG TIN CỬA HÀNG                          -->
            <!-- ========================================================== -->
            <Border Grid.Row="0" Background="#000000" CornerRadius="6" Padding="18,12" Margin="0,0,0,14">
                <Grid>
                    <!-- Logo & Tiêu đề -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo thương hiệu đầy đủ màu sắc -->
                        <Border Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                            <Image Source="/ShiftHandOver.Client;component/Assets/logo.png" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="PLUS MART" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Border BorderBrush="#FFFFFF" BorderThickness="1,0,0,0" Height="22" Margin="0,0,16,0"/>
                        <TextBlock x:Name="lblShiftInfo" Text="BIÊN BẢN GIAO NHẬN VÀ CHỐT CA" FontSize="13" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nút Thoát Ra Ngoài Màn Hình Login Ở Góc Trên Phải -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Content="Thoát ra ngoài" Height="34" Padding="14,0"
                            Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                            BorderBrush="#FFFFFF" BorderThickness="1" Cursor="Hand" Click="BtnExitReport_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- 1.1 THÔNG BÁO THÔNG TIN CA ĐÃ CHỐT / QUÁ KHỨ (CƠ SỞ, CA, NGÀY, NHÂN VIÊN CHỐT CA) -->
            <Border x:Name="bdrReadOnlyNotice" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#000000" CornerRadius="4" Padding="10,5" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="CA ĐÃ CHỐT" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                    </Border>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cơ sở: " FontWeight="Bold" Foreground="#000000" FontSize="12.5"/>
                        <TextBlock x:Name="lblReadOnlyBranch" Text="—" FontWeight="SemiBold" Foreground="#000000" FontSize="12.5" Margin="0,0,16,0"/>

                        <TextBlock Text="Ca làm: " FontWeight="Bold" Foreground="#000000" FontSize="12.5"/>
                        <TextBlock x:Name="lblReadOnlyShift" Text="—" FontWeight="SemiBold" Foreground="#000000" FontSize="12.5" Margin="0,0,16,0"/>

                        <TextBlock Text="Ngày: " FontWeight="Bold" Foreground="#000000" FontSize="12.5"/>
                        <TextBlock x:Name="lblReadOnlyDate" Text="—" FontWeight="SemiBold" Foreground="#000000" FontSize="12.5" Margin="0,0,16,0"/>

                        <TextBlock Text="Nhân viên chốt ca: " FontWeight="Bold" Foreground="#000000" FontSize="12.5"/>
                        <TextBlock x:Name="lblReadOnlyEmployees" Text="—" FontWeight="Bold" Foreground="#000000" FontSize="12.5"/>
                    </WrapPanel>

                    <TextBlock Grid.Column="2" Text="(Chế độ chỉ xem)" FontStyle="Italic" FontWeight="SemiBold" Foreground="#000000" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 1.2 THÔNG BÁO CHẾ ĐỘ CHỜ XÁC NHẬN ĐẦU CA (NConfirm) -->
            <Border x:Name="bdrNConfirmNotice" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="CA MỚI (CHƯA XÁC NHẬN): Vui lòng kiểm tra đối chiếu số liệu đầu ca từ ca trước, sau đó bấm 'XÁC NHẬN DỮ LIỆU ĐẦU CA' để mở khóa nhập liệu." FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                </StackPanel>
            </Border>

            <!-- 1.3 THÔNG BÁO CHẾ ĐỘ THAY ĐỔI THÔNG TIN ĐẦU CA (Changed - ĐẾM NGƯỢC 2 PHÚT) -->
            <Border x:Name="bdrChangedNotice" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="lblChangedNoticeTitle" Text="ĐANG SỬA THÔNG TIN ĐẦU CA:" FontWeight="Black" FontSize="13" Foreground="#000000" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblCountdownTimer" Text="Thời gian còn lại: 02:00" FontWeight="Black" FontSize="13" Foreground="#000000" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="— (Nhớ chụp và gửi bằng chứng thông số sai cho anh Hùng!)" FontWeight="Bold" FontSize="12" Foreground="#000000" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ========================================================== -->
            <!-- 2. NỘI DUNG CHÍNH: KHỐI BÊN TRÁI & KHỐI TỔNG KẾT BÊN PHẢI   -->
            <!-- ========================================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- KHỐI BÊN TRÁI: Gồm Thu chi khác, Tiền mặt, Doanh số app, Chuyển khoản -->
                    <ColumnDefinition Width="1.75*"/>
                    <ColumnDefinition Width="16"/>
                    <!-- KHỐI BÊN PHẢI: TỔNG KẾT CA -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ====================================================== -->
                <!-- 1 HÌNH BÊN TRÁI: CHỨA CẢ 4 KHU VỰC NHẬP LIỆU           -->
                <!-- ====================================================== -->
                <Border Grid.Column="0" Style="{StaticResource MainCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Card Header -->
                            <RowDefinition Height="*"/>    <!-- Card Body: 2 cột chia 4 phần -->
                        </Grid.RowDefinitions>

                        <!-- Header Khối Bên Trái -->
                        <Border Grid.Row="0" Style="{StaticResource MainCardHeader}">
                            <TextBlock Text="SỐ LIỆU GIAO NHẬN CA" Style="{StaticResource MainCardHeaderText}"/>
                        </Border>

                        <!-- Thân Khối Bên Trái: Chia 4 phần đều nhau (2 hàng x 2 cột) -->
                        <Grid Grid.Row="1" Margin="12,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ============================================== -->
                            <!-- 1. DOANH SỐ APP BÁN HÀNG (Hàng 0, Cột 0)       -->
                            <!-- ============================================== -->
                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,6" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="12,7" CornerRadius="3,3,0,0">
                                        <TextBlock Text="DOANH SỐ APP BÁN HÀNG" FontWeight="Black" FontSize="12" Foreground="#000000"/>
                                    </Border>

                                    <!-- Bố cục App POS Bán Hàng căn chỉnh chuẩn, không bị đè -->
                                    <StackPanel Grid.Row="1" Margin="12,8" VerticalAlignment="Top">
                                        <!-- Nhóm POS 1 -->
                                        <StackPanel x:Name="pnlPos1Group">
                                            <TextBlock x:Name="lblPos1Name" Text="Sapo POS" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,4"/>
                                            <Grid Margin="6,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colPos1OpenL" Width="45"/>
                                                    <ColumnDefinition x:Name="colPos1OpenV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Đầu ca :" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtPos1Opening" Style="{StaticResource MoneyLocked}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                            <Grid Margin="6,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colPos1CloseL" Width="45"/>
                                                    <ColumnDefinition x:Name="colPos1CloseV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Cuối ca :" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtPos1Closing" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                                <TextBlock x:Name="lblPos1Night" Grid.Column="2" Text="Đêm :" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="3" x:Name="txtPos1Night" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border x:Name="sepPos1" BorderBrush="#000000" BorderThickness="0,0,0,1" Margin="0,2,0,6"/>

                                        <!-- Nhóm POS 2 -->
                                        <StackPanel x:Name="pnlPos2Group">
                                            <TextBlock x:Name="lblPos2Name" Text="KiotViet" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,4"/>
                                            <Grid Margin="6,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colPos2OpenL" Width="45"/>
                                                    <ColumnDefinition x:Name="colPos2OpenV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Đầu ca :" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtPos2Opening" Style="{StaticResource MoneyLocked}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                            <Grid Margin="6,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colPos2CloseL" Width="45"/>
                                                    <ColumnDefinition x:Name="colPos2CloseV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Cuối ca :" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtPos2Closing" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                                <TextBlock x:Name="lblPos2Night" Grid.Column="2" Text="Đêm :" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="3" x:Name="txtPos2Night" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border x:Name="sepPos2" BorderBrush="#000000" BorderThickness="0,0,0,1" Margin="0,2,0,6" Visibility="Collapsed"/>

                                        <!-- Nhóm POS 3 -->
                                        <StackPanel x:Name="pnlPos3Group" Visibility="Collapsed">
                                            <TextBlock x:Name="lblPos3Name" Text="POS 3" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,4"/>
                                            <Grid Margin="6,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colPos3OpenL" Width="45"/>
                                                    <ColumnDefinition x:Name="colPos3OpenV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Đầu ca :" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtPos3Opening" Style="{StaticResource MoneyLocked}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                            <Grid Margin="6,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colPos3CloseL" Width="45"/>
                                                    <ColumnDefinition x:Name="colPos3CloseV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Cuối ca :" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtPos3Closing" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                                <TextBlock x:Name="lblPos3Night" Grid.Column="2" Text="Đêm :" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="3" x:Name="txtPos3Night" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ============================================== -->
                            <!-- 2. CHUYỂN KHOẢN (Hàng 0, Cột 1)                -->
                            <!-- ============================================== -->
                            <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,6" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="12,7" CornerRadius="3,3,0,0">
                                        <TextBlock Text="CHUYỂN KHOẢN" FontWeight="Black" FontSize="12" Foreground="#000000"/>
                                    </Border>

                                    <!-- Bố cục Ngân hàng 1 & Ngân hàng 2 căn chỉnh chuẩn, không bị đè -->
                                    <StackPanel Grid.Row="1" Margin="12,8" VerticalAlignment="Top">
                                        <!-- Nhóm Ngân hàng 1 -->
                                        <StackPanel x:Name="pnlBank1Group">
                                            <TextBlock x:Name="lblBank1Name" Text="TingTing" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,4"/>
                                            <Grid Margin="6,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colBank1OpenL" Width="45"/>
                                                    <ColumnDefinition x:Name="colBank1OpenV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Đầu ca :" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtBank1Opening" Style="{StaticResource MoneyLocked}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                            <Grid Margin="6,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colBank1CloseL" Width="45"/>
                                                    <ColumnDefinition x:Name="colBank1CloseV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Cuối ca :" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtBank1Closing" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                                <TextBlock x:Name="lblBank1Night" Grid.Column="2" Text="Đêm :" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="3" x:Name="txtBank1Night" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border x:Name="sepBank" BorderBrush="#000000" BorderThickness="0,0,0,1" Margin="0,2,0,6"/>

                                        <!-- Nhóm Ngân hàng 2 -->
                                        <StackPanel x:Name="pnlBank2Group">
                                            <TextBlock x:Name="lblBank2Name" Text="Zalo Pay" FontWeight="Black" FontSize="12" Foreground="#000000" Margin="0,0,0,4"/>
                                            <Grid Margin="6,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colBank2OpenL" Width="45"/>
                                                    <ColumnDefinition x:Name="colBank2OpenV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Đầu ca :" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtBank2Opening" Style="{StaticResource MoneyLocked}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                            <Grid Margin="6,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition x:Name="colBank2CloseL" Width="45"/>
                                                    <ColumnDefinition x:Name="colBank2CloseV" Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Cuối ca :" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="1" x:Name="txtBank2Closing" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                                <TextBlock x:Name="lblBank2Night" Grid.Column="2" Text="Đêm :" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBox   Grid.Column="3" x:Name="txtBank2Night" Style="{StaticResource MoneyInput}" Text="0" TextChanged="CalculateAll"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ============================================== -->
                            <!-- 3. TIỀN MẶT (Hàng 1, Cột 0)                    -->
                            <!-- ============================================== -->
                            <Border Grid.Row="1" Grid.Column="0" Margin="0,6,6,0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header có nút tính tiền mặt -->
                                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="3,3,0,0">
                                        <Grid>
                                            <TextBlock Text="TIỀN MẶT" FontWeight="Black" FontSize="12" Foreground="#000000" VerticalAlignment="Center"/>
                                            <Button x:Name="btnCalculateCashHeader" HorizontalAlignment="Right" Content="Tính tiền mặt" Padding="10,3" Height="26"
                                                    Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                                                    Cursor="Hand" Click="BtnOpenCashPopup_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="12,10" VerticalAlignment="Top">
                                        <!-- Hàng 1: Đầu ca -->
                                        <Grid Margin="6,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Đầu ca :" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#000000"/>
                                            <TextBox   Grid.Column="1" x:Name="txtCashOpening" Style="{StaticResource MoneyLocked}" Text="2.000.000" TextChanged="CalculateAll"/>
                                        </Grid>

                                        <!-- Hàng 2: Cuối ca + Nút Đếm tiền ngay cạnh ô nhập -->
                                        <Grid Margin="6,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Cuối ca :" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                            <TextBox   Grid.Column="1" x:Name="txtCashClosing" Style="{StaticResource MoneyInput}" Text="2.739.000" TextChanged="CalculateAll"/>
                                            <Button    x:Name="btnOpenCashPopup" Grid.Column="2" Content="Đếm tiền" Margin="8,0,0,0" Padding="12,0" Height="30"
                                                       Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                                                       Cursor="Hand" Click="BtnOpenCashPopup_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ============================================== -->
                            <!-- 4. THU CHI KHÁC (Hàng 1, Cột 1)                -->
                            <!-- ============================================== -->
                            <Border Grid.Row="1" Grid.Column="1" Margin="6,6,0,0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header + Nút thêm khoản chi -->
                                        <RowDefinition Height="*"/>    <!-- Danh sách cuộn các khoản chi -->
                                        <RowDefinition Height="Auto"/> <!-- Tổng tiền chi -->
                                    </Grid.RowDefinitions>

                                    <!-- Header có nút thêm khoản chi -->
                                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="3,3,0,0">
                                        <Grid>
                                            <TextBlock Text="THU CHI KHÁC" FontWeight="Black" FontSize="12" Foreground="#000000" VerticalAlignment="Center"/>
                                            <Button x:Name="btnAddExpense" HorizontalAlignment="Right" Content="Thêm khoản chi" Padding="10,3" Height="26"
                                                    Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                                                    Cursor="Hand" Click="BtnAddExpense_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Danh sách động các khoản chi -->
                                    <Grid Grid.Row="1" Margin="12,6,12,4" MinHeight="70">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header cột -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SẢN PHẨM / KHOẢN CHI" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                            <TextBlock Grid.Column="1" Text="TIỀN CHI (VNĐ)" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </Grid>

                                        <!-- Danh sách dòng chi -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="85">
                                            <StackPanel x:Name="pnlExpenseItems"/>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- Tổng kết tiền chi trong ca -->
                                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="12,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tổng tiền chi trong ca :" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="#000000"/>
                                            <TextBox   Grid.Column="1" x:Name="txtOtherExpenses" Style="{StaticResource MoneyLocked}" Text="0" Height="28" FontSize="11" FontWeight="Black"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ====================================================== -->
                <!-- 1 HÌNH BÊN PHẢI: TỔNG KẾT CA                          -->
                <!-- ====================================================== -->
                <Border Grid.Column="2" Style="{StaticResource MainCard}" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Khối Tổng Kết -->
                        <Border Grid.Row="0" Style="{StaticResource MainCardHeader}">
                            <TextBlock Text="TỔNG KẾT CA" Style="{StaticResource MainCardHeaderText}"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16">
                            <StackPanel>
                                <!-- 1. Doanh thu -->
                                <TextBlock Text="Doanh thu:" FontWeight="Bold" Foreground="#000000" FontSize="13" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtTotalPosRevenue" Style="{StaticResource MoneyCalculated}" Text="2.816.000" Height="40" FontSize="15" Margin="0,0,0,16"/>

                                <!-- 2. Tổng tiền chuyển khoản trong ca -->
                                <TextBlock Text="Tổng tiền chuyển khoản trong ca:" FontWeight="Bold" Foreground="#000000" FontSize="13" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtTotalBankRevenue" Style="{StaticResource MoneyCalculated}" Text="2.100.000" Height="40" FontSize="15" Margin="0,0,0,16"/>

                                <!-- 3. Tiền mặt chênh lệch kết ca -->
                                <TextBlock Text="Tiền mặt chênh lệch kết ca:" FontWeight="Bold" Foreground="#000000" FontSize="13" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtSummaryCashClosing" Style="{StaticResource MoneyCalculated}" Text="0" Height="40" FontSize="15" Margin="0,0,0,18"/>

                                <!-- 4. Tiền chênh lệch (tiền âm hay dương của ca đó) -->
                                <Border x:Name="bdrCashDiff" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="6" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Tiền chênh lệch:" FontWeight="Black" FontSize="13" Foreground="#000000" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="#000000" CornerRadius="4" Padding="8,3">
                                                <TextBlock x:Name="lblCashDiffStatus" Text="" FontWeight="Black" Foreground="#FFFFFF" FontSize="11"/>
                                            </Border>
                                        </Grid>

                                        <TextBox x:Name="txtCashDifference" FontSize="24" FontWeight="Black"
                                                 Foreground="#000000" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5"
                                                 Height="48" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                 Padding="10,0" IsReadOnly="True" Text="-23.000 đ"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================== -->
            <!-- 3. FOOTER: BÀN GIAO CA & CÁC NÚT THAO TÁC                 -->
            <!-- ========================================================== -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Ghi chú chung -->
                        <ColumnDefinition Width="*"/>
                        <!-- Nút Chốt ca -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ghi chú ca -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Ghi chú bàn giao ca:" FontSize="12" FontWeight="SemiBold" Foreground="#000000" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNote" Height="36" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#000000" Text="Hụt 23k do làm rơi tiền lẻ"/>
                    </StackPanel>

                    <!-- Các nút hành động ở Footer -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <!-- Nút Thoát ra ngoài -->
                        <Button Content="Thoát ra ngoài" Height="36" Padding="14,0" Margin="0,0,10,0"
                                Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" FontSize="13"
                                BorderBrush="#000000" BorderThickness="1.5" Cursor="Hand" Click="BtnExitReport_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Nút Thay đổi thông tin (Hiển thị ở trạng thái NConfirm) -->
                        <Button x:Name="btnChangeInitialData" Content="Thay đổi thông tin" Height="36" Padding="14,0" Margin="0,0,10,0"
                                Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" FontSize="13"
                                BorderBrush="#000000" BorderThickness="1.5" Cursor="Hand" Click="BtnChangeInitialData_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>



                        <!-- Nút Chốt ca -->
                        <Button x:Name="btnSaveHandover" Content="HOÀN TẤT VÀ CHỐT CA" Width="210" Height="36"
                                Background="#000000" Foreground="#FFFFFF" FontWeight="Black" FontSize="13"
                                BorderThickness="0" Cursor="Hand" Click="BtnSaveHandover_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- POPUP MODAL: KIỂM ĐẾM TIỀN MẶT THEO MỆNH GIÁ                   -->
        <!-- ============================================================== -->
        <Grid x:Name="popCashCounter" Visibility="Collapsed" Background="#000000">
            <Border Background="#FFFFFF" CornerRadius="6" Width="520" Height="680"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#000000" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                </Border.Effect>

                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <Border Grid.Row="0" Margin="0,0,0,16" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BẢNG KIỂM ĐẾM TIỀN MẶT" FontSize="18" FontWeight="Black" Foreground="#000000" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" Content="X" Width="30" Height="30" Background="Transparent"
                                    BorderThickness="0" FontSize="16" FontWeight="Bold" Foreground="#000000"
                                    Cursor="Hand" Click="BtnCloseCashPopup_Click"/>
                        </Grid>
                    </Border>

                    <!-- Danh sách 9 mệnh giá (Đen Trắng) -->
                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="4" Padding="16,8" BorderBrush="#000000" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mệnh giá" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Số tờ" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Thành tiền" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- 500.000 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="500.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtCount500k" Text="0" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lblTotal500k" Text="0 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>

                                <!-- 200.000 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="200.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtCount200k" Text="5" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="lblTotal200k" Text="1.000.000 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>

                                <!-- 100.000 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="100.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtCount100k" Text="14" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="lblTotal100k" Text="1.400.000 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>

                                <!-- 50.000 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="50.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtCount50k" Text="3" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="lblTotal50k" Text="150.000 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>

                                <!-- 20.000 -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="20.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="txtCount20k" Text="2" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" x:Name="lblTotal20k" Text="40.000 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>

                                <!-- 10.000 -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="10.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="txtCount10k" Text="8" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="lblTotal10k" Text="80.000 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>

                                <!-- 5.000 -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="5.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="7" Grid.Column="1" x:Name="txtCount5k" Text="6" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="7" Grid.Column="2" x:Name="lblTotal5k" Text="30.000 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>

                                <!-- 2.000 -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="2.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="8" Grid.Column="1" x:Name="txtCount2k" Text="10" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="8" Grid.Column="2" x:Name="lblTotal2k" Text="20.000 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>

                                <!-- 1.000 -->
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="1.000 đ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBox   Grid.Row="9" Grid.Column="1" x:Name="txtCount1k" Text="19" Height="28" Width="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#000000" TextChanged="CalculateCashCount"/>
                                <TextBlock Grid.Row="9" Grid.Column="2" x:Name="lblTotal1k" Text="19.000 đ" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#000000"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Modal: Tổng cộng & Nút xác nhận -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Box tổng tiền -->
                        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="4" Padding="16,10" BorderBrush="#000000" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TỔNG TIỀN KIỂM ĐẾM:" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="lblGrandTotalCash" Text="2.739.000 đ"
                                           FontSize="18" FontWeight="Black" Foreground="#000000" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Nút bấm -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Đóng lại" Height="40" Margin="0,0,6,0"
                                    Background="#FFFFFF" Foreground="#000000" FontWeight="SemiBold"
                                    BorderBrush="#000000" BorderThickness="1" Click="BtnCloseCashPopup_Click"/>

                            <Button x:Name="btnApplyCashPopup" Grid.Column="1" Content="Áp dụng vào Tiền mặt két" Height="40" Margin="6,0,0,0"
                                    Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                                    BorderThickness="0" Cursor="Hand" Click="BtnApplyCashPopup_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
