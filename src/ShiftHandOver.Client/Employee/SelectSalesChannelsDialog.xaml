<Window x:Class="ShiftHandOver.Client.Employee.SelectSalesChannelsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Kênh Bán Hàng Trong Ca"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="CardCheckBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardCheckBox" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0F172A" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Body Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER -->
            <Border Grid.Row="0" Background="#0F172A" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="CHỌN KÊNH BÁN HÀNG TRONG CA" FontWeight="Black" FontSize="15" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="lblBranchShiftInfo" Text="Cơ sở: — | Ca: —" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    <TextBlock Text="Tích chọn các ứng dụng POS và Ngân hàng sẽ sử dụng trong ca này. (Danh sách ngân hàng do Quản trị viên đã thiết lập đối với cơ sở này)." 
                               FontSize="11" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 2. BODY CONTENT -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <!-- NHÓM 1: APP POS BÁN HÀNG -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="1. APP POS BÁN HÀNG" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                    <Border Grid.Column="1" Background="#EEF2F6" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Chọn một hoặc nhiều" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                    </Border>
                </Grid>

                <!-- Thẻ POS 1 -->
                <Border x:Name="cardPos1" Style="{StaticResource CardCheckBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkPos1" Style="{StaticResource CardCheckBox}" Margin="4,0,12,0"/>
                        <Border Grid.Column="1" x:Name="bdrPos1Logo" Width="36" Height="36" CornerRadius="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                            <Image x:Name="imgPos1Logo" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="lblPos1Name" Text="Sapo POS" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                            <TextBlock Text="Kênh máy POS ghi nhận doanh thu bán hàng" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Thẻ POS 2 -->
                <Border x:Name="cardPos2" Style="{StaticResource CardCheckBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkPos2" Style="{StaticResource CardCheckBox}" Margin="4,0,12,0"/>
                        <Border Grid.Column="1" x:Name="bdrPos2Logo" Width="36" Height="36" CornerRadius="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                            <Image x:Name="imgPos2Logo" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="lblPos2Name" Text="KiotViet" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                            <TextBlock Text="Kênh máy POS ghi nhận doanh thu bán hàng" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Thẻ POS 3 (Ẩn nếu không có) -->
                <Border x:Name="cardPos3" Style="{StaticResource CardCheckBorder}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkPos3" Style="{StaticResource CardCheckBox}" Margin="4,0,12,0"/>
                        <Border Grid.Column="1" x:Name="bdrPos3Logo" Width="36" Height="36" CornerRadius="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                            <Image x:Name="imgPos3Logo" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="lblPos3Name" Text="POS 3" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                            <TextBlock Text="Kênh máy POS ghi nhận doanh thu bán hàng" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- NHÓM 2: NGÂN HÀNG / VÍ ĐIỆN TỬ -->
                <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="2. NGÂN HÀNG / VÍ ĐIỆN TỬ BÁN HÀNG" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                    <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Admin đã xét cho cơ sở" FontSize="10" FontWeight="SemiBold" Foreground="#0369A1"/>
                    </Border>
                </Grid>

                <!-- Thẻ Bank 1 -->
                <Border x:Name="cardBank1" Style="{StaticResource CardCheckBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkBank1" Style="{StaticResource CardCheckBox}" Margin="4,0,12,0"/>
                        <Border Grid.Column="1" x:Name="bdrBank1Logo" Width="36" Height="36" CornerRadius="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                            <Image x:Name="imgBank1Logo" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="lblBank1Name" Text="TingTing" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                            <TextBlock Text="Tài khoản nhận tiền chuyển khoản / quét mã QR" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Thẻ Bank 2 -->
                <Border x:Name="cardBank2" Style="{StaticResource CardCheckBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkBank2" Style="{StaticResource CardCheckBox}" Margin="4,0,12,0"/>
                        <Border Grid.Column="1" x:Name="bdrBank2Logo" Width="36" Height="36" CornerRadius="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                            <Image x:Name="imgBank2Logo" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="lblBank2Name" Text="Zalo Pay" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                            <TextBlock Text="Tài khoản nhận tiền chuyển khoản / quét mã QR" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Thẻ Bank 3 (Ẩn nếu không có) -->
                <Border x:Name="cardBank3" Style="{StaticResource CardCheckBorder}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkBank3" Style="{StaticResource CardCheckBox}" Margin="4,0,12,0"/>
                        <Border Grid.Column="1" x:Name="bdrBank3Logo" Width="36" Height="36" CornerRadius="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                            <Image x:Name="imgBank3Logo" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="lblBank3Name" Text="Ngân hàng 3" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                            <TextBlock Text="Tài khoản nhận tiền chuyển khoản / quét mã QR" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- HỘP THÔNG BÁO LƯU Ý -->
                <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run FontWeight="Bold">Lưu ý:</Run> Màn hình biên bản chốt ca sẽ chỉ hiển thị và tính toán các App POS và Ngân hàng đã được tích chọn ở trên.
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. FOOTER -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancel" Content="QUAY LẠI" Width="105" Height="36"
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                            FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="BtnCancel_Click"/>
                    <Button x:Name="btnConfirm" Content="XÁC NHẬN &amp; VÀO BIÊN BẢN" Height="36" Padding="18,0" Margin="10,0,0,0"
                            Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0"
                            FontWeight="Bold" FontSize="12" Cursor="Hand" Click="BtnConfirm_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
